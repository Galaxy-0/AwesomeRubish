+// CopyCommands owns the copied bytes. CallCommands alone retains a reference
+// to the source handle, whose storage must remain alive until execution.
+static const tex_t *cmd_copy_tex(const tex_t *t, const uint8_t *src, uint8_t *dst, uint32_t size) {
+    uintptr_t a = (uintptr_t)t, lo = (uintptr_t)src;
+    return a >= lo && a - lo < size ? (const tex_t *)(dst + (a - lo)) : t;
+}
+static void cmd_copy_record(cmd_t *o, const uint8_t *src, op_hdr h) {
+    uint8_t *dst = cmd_alloc(o, h.size); memcpy(dst, src, h.size);
+    cs_op(h.op, h.size);
+    void *a = dst + 8;
+    // Texture snapshots live inside the record. External resources and nested
+    // CALL targets retain their original addresses.
+    switch (h.op) {
+        case OP_SET_RT: {
+            p_set_rt *r = a;
+            for (int i = 0; i < r->n; i++) r->color[i] = cmd_copy_tex(r->color[i], src, dst, h.size);
+            r->depth = cmd_copy_tex(r->depth, src, dst, h.size); break;
+        }
+        case OP_COPY_B2T: case OP_COPY_T2B: {
+            p_copy_b2t *r = a; r->tex = cmd_copy_tex(r->tex, src, dst, h.size); break;
+        }
+        case OP_COPY_T2T: {
+            p_copy_t2t *r = a;
+            r->src = cmd_copy_tex(r->src, src, dst, h.size);
+            r->dst = cmd_copy_tex(r->dst, src, dst, h.size); break;
+        }
+        case OP_CLEAR_TEX: {
+            p_clear_tex *r = a; r->tex = cmd_copy_tex(r->tex, src, dst, h.size); break;
+        }
+    }
+}
+NVN(nvnCommandBufferCopyCommands, void, NVNcommandBuffer *c, int n, const NVNcommandHandle *handles) {
+    for (int i = 0; i < n; i++) {
+        const uint8_t *p = (const uint8_t *)handles[i];
+        for (unsigned count = 0; ; count++) {
+            op_hdr h; memcpy(&h, p, sizeof h);
+            if (count >= 1000000 || ((uintptr_t)p & 7) || h.size < 8 || (h.size & 7) || h.op >= OP_COUNT_)
+                die("CopyCommands invalid source %p: op=%u size=%u", p, h.op, h.size);
+            if (h.op == OP_END) break;
+            if (h.op == OP_JUMP) { memcpy(&p, p + 8, 8); continue; }
+            if (h.op != OP_BEGIN) cmd_copy_record(CB(c), p, h);
+            p += h.size;
+        }
+    }
 }
