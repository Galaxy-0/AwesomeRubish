+    } else {
+        uint64_t previous=atomic_load(&rl_frame);
+        if (frame!=previous+1) die("RL present frame mismatch previous=%llu frame=%llu",previous,frame);
+        if (atomic_load(&rl_input_seen[previous&4095])!=previous) rl_without_input++;
+        if (atomic_load(&rl_remaining) > 0) atomic_fetch_sub(&rl_remaining, 1);
+    }
+    atomic_store(&rl_frame,frame);
+    if (atomic_load(&rl_remaining)) return;
+    if (!rl_clock) guest_clock_freeze_for(3, 1);
