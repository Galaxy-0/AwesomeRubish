+static int rl_write(const void *data, size_t length) {
+    const uint8_t *p = data;
+    while (length) {
+#ifdef MSG_NOSIGNAL
+        ssize_t n = send(rl_peer, p, length, MSG_NOSIGNAL);
+#else
+        ssize_t n = send(rl_peer, p, length, 0);
+#endif
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return 0;
+        p += n; length -= (size_t)n;
+    }
+    return 1;
+}
