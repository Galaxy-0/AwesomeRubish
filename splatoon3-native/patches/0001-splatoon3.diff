@@ -0,0 +1,307 @@
+// Virtual local wireless over a user-started AF_UNIX medium (tools/ldn/air.py).
+// State/NetworkInfo layouts: switchbrew/libnx services/ldn.h. C++ Scan/Create
+// wrappers checked against SDK 22.5.0 in the user's dump. Game data is opaque.
+#include "hle.h"
+#include "hle_ldn.h"
+#include <errno.h>
+#include <limits.h>
+#include <stdatomic.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+enum { LDN_INVALID_STATE = 0x40cb, LDN_NET = 0x480, LDN_MAGIC = 0x334e444c, LDN_LIMIT = 65536 };
+static _Atomic int g_ldn_state;
+static int g_ldn_reason, g_ldn_node = -1;
+static uint8_t g_ldn_net[LDN_NET], g_ldn_history[64];
+static void *g_ldn_event;
+static pthread_mutex_t ldn_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t ldn_rpc_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t ldn_response = PTHREAD_COND_INITIALIZER;
+static pthread_t ldn_thread;
+static int ldn_fd = -1, ldn_running, ldn_done;
+static uint32_t ldn_sequence, ldn_error;
+static void *ldn_reply;
+static size_t ldn_reply_cap, ldn_reply_size;
+static __thread int ldn_skerr = 100;
+
+static int ldn_build(void) { return !strcmp(dm_main_build(), "28c4287aee36f7499da60f3e68b54c70"); }
+static int ldn_frontend(void) {
+    const char *e = getenv("DM_LDN_FRONTEND");
+    return e && !strcmp(e, "1") && ldn_build();
+}
+int dm_ldn_enabled(void) { return ldn_build() && getenv("DM_LDN_AIR") && *getenv("DM_LDN_AIR"); }
+int dm_ldn_errno(void) { return ldn_skerr; }
+static uint32_t ld32(const void *p) { uint32_t x; memcpy(&x, p, 4); return x; }
+static int transfer(int fd, void *p, size_t n, int sending) {
+    for (size_t done = 0; done < n;) {
+        ssize_t k = sending ? send(fd, (char *)p + done, n-done, 0) : recv(fd, (char *)p + done, n-done, 0);
+        if (k < 0 && errno == EINTR) continue;
+        if (k <= 0) return -1;
+        done += (size_t)k;
+    }
+    return 0;
+}
+static void *ldn_reader(void *unused) {
+    (void)unused;
+    uint8_t *b = malloc(LDN_LIMIT);
+    uint32_t h[4];
+    while (b && !transfer(ldn_fd, h, sizeof h, 0) && h[0] == LDN_MAGIC && h[3] <= LDN_LIMIT &&
+           !transfer(ldn_fd, b, h[3], 0)) {
+        pthread_mutex_lock(&ldn_lock);
+        if (h[1] == 100 && h[3] == 12+LDN_NET) {
+            int state = (int)ld32(b), node = (int)ld32(b+8);
+            for (int i = 0; i < 8; i++) {
+                int old = g_ldn_net[0x68+i*64+11], next = b[12+0x68+i*64+11];
+                if (old != next) g_ldn_history[i*8] |= next ? 1 : 2;
+            }
+            int changed = atomic_load(&g_ldn_state) != state || memcmp(g_ldn_net, b+12, LDN_NET);
+            g_ldn_reason = (int)ld32(b+4); g_ldn_node = node;
+            memcpy(g_ldn_net, b+12, LDN_NET);
+            atomic_store(&g_ldn_state, state);
+            // The event was already bound on a guest thread. Holding the lock
+            // prevents Finalize from detaching it while the reader signals it.
+            if (changed && g_ldn_event) hle_signal_system_event(g_ldn_event);
+            if (changed) LOG("LDN state=%d node=%d nodes=%u session=%02x%02x%02x%02x", state, node,
+                             g_ldn_net[0x67], g_ldn_net[16], g_ldn_net[17], g_ldn_net[18], g_ldn_net[19]);
+        } else if ((h[1] & 0x80000000u) && h[2] == ldn_sequence && h[3] >= 4) {
+            ldn_error = ld32(b); ldn_reply_size = h[3]-4;
+            if (ldn_reply_size > ldn_reply_cap) ldn_error = 90;
+            else if (ldn_reply_size) memcpy(ldn_reply, b+4, ldn_reply_size);
+            ldn_done = 1; pthread_cond_signal(&ldn_response);
+        } else {
+            pthread_mutex_unlock(&ldn_lock); break;
+        }
+        pthread_mutex_unlock(&ldn_lock);
+    }
+    free(b);
+    pthread_mutex_lock(&ldn_lock);
+    ldn_running = 0; atomic_store(&g_ldn_state, 0); g_ldn_reason = 6;
+    if (g_ldn_event) hle_signal_system_event(g_ldn_event);
+    pthread_cond_broadcast(&ldn_response);
+    pthread_mutex_unlock(&ldn_lock);
+    return NULL;
+}
+static int ldn_rpc(int op, const void *data, size_t n, void *out, size_t cap, size_t *actual) {
+    if (n > LDN_LIMIT || (n && !data)) return 22;
+    pthread_mutex_lock(&ldn_rpc_lock);
+    pthread_mutex_lock(&ldn_lock);
+    if (!ldn_running) { pthread_mutex_unlock(&ldn_lock); pthread_mutex_unlock(&ldn_rpc_lock); return 50; }
+    uint32_t h[] = { LDN_MAGIC, (uint32_t)op, ++ldn_sequence, (uint32_t)n };
+    ldn_done = 0; ldn_reply = out; ldn_reply_cap = cap; ldn_reply_size = 0;
+    pthread_mutex_unlock(&ldn_lock);
+    int err = transfer(ldn_fd, h, sizeof h, 1) || transfer(ldn_fd, (void *)data, n, 1);
+    pthread_mutex_lock(&ldn_lock);
+    struct timespec deadline; clock_gettime(CLOCK_REALTIME, &deadline); deadline.tv_sec += 3;
+    while (!err && ldn_running && !ldn_done)
+        if (pthread_cond_timedwait(&ldn_response, &ldn_lock, &deadline) == ETIMEDOUT) err = 1;
+    int result = err || !ldn_done ? 50 : (int)ldn_error;
+    if (actual) *actual = ldn_reply_size;
+    ldn_reply = NULL; ldn_reply_cap = 0;
+    pthread_mutex_unlock(&ldn_lock);
+    if (err) shutdown(ldn_fd, SHUT_RDWR);
+    pthread_mutex_unlock(&ldn_rpc_lock);
+    return result;
+}
+static void ldn_caller(const char *label, void *pc) {
+    for (int i=0;i<g_nmod;i++) if ((uint8_t *)pc >= g_mod[i].base && (uint8_t *)pc < g_mod[i].base+g_mod[i].size) {
+        LOG("LDN %s caller=%s+%#llx",label,g_mod[i].name,(unsigned long long)((uint8_t *)pc-g_mod[i].base)); return;
+    }
+}
+static Result ldn_cmd(int op, const void *b, size_t n) {
+    int err = ldn_rpc(op, b, n, NULL, 0, NULL);
+    if (err) LOG("LDN command=%d failed errno=%d state=%d", op, err, atomic_load(&g_ldn_state));
+    return err ? RES_FAIL : RES_OK;
+}
+HLE_FORCE("_ZN2nn3ldn10InitializeEv", "local virtual LDN or opt-in idle frontend", Result, h_ldn_Init, void) {
+    if (atomic_load(&g_ldn_state)) return RES_FAIL;
+    if (!dm_ldn_enabled()) {
+        if (ldn_frontend()) { atomic_store(&g_ldn_state, 1); LOG("LDN Initialize: local frontend initialized; no network"); return RES_OK; }
+        return RES_FAIL;
+    }
+    const char *path = getenv("DM_LDN_AIR"), *player = getenv("DM_PLAYER");
+    if (!player || strlen(player) != 1 || *player < '0' || *player > '7') return RES_FAIL;
+    struct sockaddr_un a = { .sun_family = AF_UNIX };
+    if (strlen(path) >= sizeof a.sun_path) return RES_FAIL;
+    strcpy(a.sun_path, path);
+    ldn_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (ldn_fd < 0) return RES_FAIL;
+    int no_sigpipe = 1; setsockopt(ldn_fd, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof no_sigpipe);
+    struct timeval timeout = {3, 0}; setsockopt(ldn_fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof timeout);
+    if (connect(ldn_fd, (void *)&a, sizeof a)) { close(ldn_fd); ldn_fd = -1; return RES_FAIL; }
+    ldn_running = 1;
+    if (pthread_create(&ldn_thread, NULL, ldn_reader, NULL)) { ldn_running = 0; close(ldn_fd); ldn_fd = -1; return RES_FAIL; }
+    uint32_t p = *player - '0';
+    int err = ldn_rpc(1, &p, 4, NULL, 0, NULL);
+    if (err) { shutdown(ldn_fd, SHUT_RDWR); pthread_join(ldn_thread, NULL); close(ldn_fd); ldn_fd = -1; return RES_FAIL; }
+    LOG("LDN Initialize: virtual medium player=%u unix=%s", p, path);
+    return RES_OK;
+}
+HLE_FORCE("_ZN2nn3ldn8FinalizeEv", "detach local medium", void, h_ldn_Fini, void) {
+    pthread_mutex_lock(&ldn_lock); void *ev = g_ldn_event; g_ldn_event = NULL; pthread_mutex_unlock(&ldn_lock);
+    if (ev) hle_forget_system_event(ev);
+    if (ldn_fd >= 0) (void)ldn_rpc(16,NULL,0,NULL,0,NULL);
+    if (ldn_fd >= 0) { shutdown(ldn_fd, SHUT_RDWR); pthread_join(ldn_thread, NULL); close(ldn_fd); ldn_fd = -1; }
+    pthread_mutex_lock(&ldn_lock);
+    memset(g_ldn_net, 0, sizeof g_ldn_net); memset(g_ldn_history, 0, sizeof g_ldn_history);
+    g_ldn_reason = 0; g_ldn_node = -1; atomic_store(&g_ldn_state, 0);
+    pthread_mutex_unlock(&ldn_lock);
+}
+HLE_FORCE("_ZN2nn3ldn8GetStateEv", "virtual LDN state", int, h_ldn_State, void) { return ldn_build() ? atomic_load(&g_ldn_state) : 0; }
+HLE_FORCE("_ZN2nn3ldn11SetProtocolENS0_8ProtocolE", "NX protocol selection", Result, h_ldn_Protocol, int p) {
+    return ldn_build() && atomic_load(&g_ldn_state) == 1 && (p == 0 || p == 1 || p == 3) ? RES_OK : RES_FAIL;
+}
+HLE_FORCE("_ZN2nn3ldn22AttachStateChangeEventEPNS_2os15SystemEventTypeE", "virtual LDN state event", void, h_ldn_Attach, void *ev) {
+    hle_bind_system_event(ev, 1);
+    pthread_mutex_lock(&ldn_lock); g_ldn_event = ev; pthread_mutex_unlock(&ldn_lock);
+}
+#define LDN_SIMPLE(symbol, name, op) HLE_FORCE(symbol, "virtual local LDN", Result, name, void) { ldn_caller(#name,__builtin_return_address(0)); return ldn_cmd(op, NULL, 0); }
+LDN_SIMPLE("_ZN2nn3ldn11OpenStationEv", h_ldn_OpenSta, 3)
+LDN_SIMPLE("_ZN2nn3ldn12CloseStationEv", h_ldn_CloseSta, 5)
+LDN_SIMPLE("_ZN2nn3ldn15OpenAccessPointEv", h_ldn_OpenAp, 2)
+LDN_SIMPLE("_ZN2nn3ldn16CloseAccessPointEv", h_ldn_CloseAp, 4)
+LDN_SIMPLE("_ZN2nn3ldn10DisconnectEv", h_ldn_Disc, 10)
+LDN_SIMPLE("_ZN2nn3ldn14DestroyNetworkEv", h_ldn_Destroy, 9)
+LDN_SIMPLE("_ZN2nn3ldn17ClearAcceptFilterEv", h_ldn_ClearFilter, 14)
+static Result ldn_scan(void *out, int *count, int max, const void *filter, int channel, int priv) {
+    if (count) *count = 0;
+    if (!out || !count || !filter || max < 1 || channel < 0) return RES_FAIL;
+    if (max > 24) max = 24;
+    uint8_t request[108] = {0}; memcpy(request, &channel, 4); memcpy(request+4, &max, 4);
+    memcpy(request+8, filter, 96); memcpy(request+104, &priv, 4);
+    size_t size = 0, cap = 4 + max*LDN_NET;
+    uint8_t *reply = malloc(cap);
+    if (!reply) return RES_FAIL;
+    int err = ldn_rpc(7, request, sizeof request, reply, cap, &size);
+    if (!err && size >= 4 && ld32(reply) <= (unsigned)max && size == 4+ld32(reply)*LDN_NET) {
+        *count = (int)ld32(reply); memcpy(out, reply+4, size-4);
+        static unsigned calls; if (*count || !(calls++ % 120)) LOG("LDN Scan: private=%d count=%d flags=%#x", priv, *count, ld32((const char *)filter+92));
+    } else err = 1;
+    free(reply); return err ? RES_FAIL : RES_OK;
+}
+HLE_FORCE("_ZN2nn3ldn4ScanEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", "virtual LDN scan", Result, h_ldn_Scan, void *out, int *n, int max, const void *f, int ch) { ldn_caller("Scan",__builtin_return_address(0)); return ldn_scan(out,n,max,f,ch,0); }
+HLE_FORCE("_ZN2nn3ldn11ScanPrivateEPNS0_11NetworkInfoEPiiRKNS0_10ScanFilterEi", "virtual private LDN scan", Result, h_ldn_ScanP, void *out, int *n, int max, const void *f, int ch) { return ldn_scan(out,n,max,f,ch,1); }
+static Result ldn_create(const void *config, const void *sec, const void *param, const void *user, int n, const void *addresses) {
+    if (!config || !sec || !user || n < 0 || n > 8 || (n && !addresses)) return RES_FAIL;
+    // C++ UserConfig holds 32 bytes; the IPC form reserves 48 (SDK CreateNetwork wrapper).
+    uint8_t b[280] = {0}; memcpy(b, config, 32); memcpy(b+32, sec, 68); memcpy(b+100, user, 32);
+    if (param) memcpy(b+148, param, 32);
+    memcpy(b+180, &n, 4); if (n) memcpy(b+184, addresses, n*12);
+    LOG("LDN CreateNetwork: intent=%llx scene=%u version=%u max=%u private=%d", (unsigned long long)(*(const uint64_t *)config),
+        (unsigned)((const uint16_t *)config)[5], (unsigned)((const uint16_t *)config)[10], ((const uint8_t *)config)[18], n);
+    return ldn_cmd(6, b, 184+n*12);
+}
+HLE_FORCE("_ZN2nn3ldn13CreateNetworkERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_10UserConfigE", "virtual LDN create", Result, h_ldn_Create, const void *a, const void *b, const void *c) { return ldn_create(a,b,NULL,c,0,NULL); }
+HLE_FORCE("_ZN2nn3ldn20CreateNetworkPrivateERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_17SecurityParameterERKNS0_10UserConfigEiPKNS0_12AddressEntryE", "virtual private LDN create", Result, h_ldn_CreateP, const void *a,const void *b,const void *c,const void *d,int n,const void *e) { return ldn_create(a,b,c,d,n,e); }
+HLE_FORCE("_ZN2nn3ldn7ConnectERKNS0_11NetworkInfoERKNS0_14SecurityConfigERKNS0_10UserConfigEiNS0_13ConnectOptionE", "virtual LDN connect", Result, h_ldn_Connect, const void *a,const void *b,const void *c,int v,int o) {
+    if (!a || !b || !c || v < 0 || v > 32767 || o < 0 || o > 1) return RES_FAIL;
+    uint8_t request[LDN_NET+124] = {0}; memcpy(request,a,LDN_NET); memcpy(request+LDN_NET,b,68); memcpy(request+LDN_NET+68,c,32);
+    memcpy(request+LDN_NET+116,&v,4); memcpy(request+LDN_NET+120,&o,4);
+    return ldn_cmd(8,request,sizeof request);
+}
+HLE_FORCE("_ZN2nn3ldn14ConnectPrivateERKNS0_13NetworkConfigERKNS0_14SecurityConfigERKNS0_17SecurityParameterERKNS0_10UserConfigEiNS0_13ConnectOptionE", "virtual private LDN connect", Result, h_ldn_ConnectP, const void *a,const void *b,const void *c,const void *d,int v,int o) {
+    if (!a || !b || !c || !d) return RES_FAIL;
+    uint8_t filter[96] = {0}, *nets = malloc(24*LDN_NET); int count = 0;
+    if (!nets) return RES_FAIL;
+    memcpy(filter,a,16); memcpy(filter+16,(const char *)c+16,16); uint32_t flags = 0x23; memcpy(filter+92,&flags,4);
+    Result r = ldn_scan(nets,&count,24,filter,0,1);
+    r = !r && count ? h_ldn_Connect(nets,b,d,v,o) : RES_FAIL;
+    free(nets); return r;
+}
+HLE_FORCE("_ZN2nn3ldn14GetNetworkInfoEPNS0_11NetworkInfoE", "virtual LDN network snapshot", Result, h_ldn_NetInfo, void *out) {
+    pthread_mutex_lock(&ldn_lock); int s = atomic_load(&g_ldn_state);
+    int ok = out && (s == 3 || s == 5); if (ok) memcpy(out,g_ldn_net,LDN_NET);
+    pthread_mutex_unlock(&ldn_lock);
+    // main+0x9576cc polls this even while idle and explicitly ignores LDN's
+    // module-203 InvalidState range (0x40cb). A generic offline failure instead
+    // becomes a latched communication error before the room can be created.
+    return ok ? RES_OK : (dm_ldn_enabled() ? LDN_INVALID_STATE : RES_FAIL);
+}
