+void uimsg_subscribe(void (*fn)(const char *,const char *,const char *)){(void)fn;}
+static int checks,failed;
+static int frame_allowed=1;
+int dm_rl_frame_allowed(uint64_t frame) { (void)frame;return frame_allowed; }
+#define CHECK(x) do{checks++;if(!(x)){failed++;fprintf(stderr,"FAIL %d\n",__LINE__);}}while(0)
+int main(int argc,char **argv){
+    if(argc>1 && !strcmp(argv[1],"fixed60")){
+        unsetenv("DM_DETCLOCK");setenv("DM_RL_CLOCK_MODE","fixed60",1);
+        dm_rl_clock clock={0};uint64_t before=guest_ns();
+        dm_guest_clock_share(&clock);uint64_t initial=guest_ns();
+        CHECK(initial>=before);CHECK(dm_detclock_enabled());
+        for(uint64_t n=1;n<=3600;n++) {
+            frame_allowed=0;dm_guest_frame_begin();CHECK(guest_ns()-initial==(n-1)*UINT64_C(1000000000)/60);
+            frame_allowed=1;dm_guest_frame_begin();
+            uint64_t begun=guest_ns();dm_guest_frame_begin();CHECK(guest_ns()==begun);
+            usleep(n%97==0 ? 1000 : 0);dm_guest_frame_tick();
+            CHECK(guest_ns()-initial==n*UINT64_C(1000000000)/60);
+        }
+        uint64_t held=guest_ns();usleep(30000);CHECK(guest_ns()==held);
+        CHECK(held-initial==UINT64_C(60000000000));
+        for(int repeat=0;repeat<3;repeat++) {
+            uint64_t before_release=guest_ns();dm_guest_clock_release();
+            uint64_t released=guest_ns();CHECK(!dm_guest_fixed60());
+            CHECK(released>=before_release && released-before_release<50000000);
+            usleep(3000);CHECK(guest_ns()>released);
+            uint64_t before_attach=guest_ns();dm_guest_clock_share(&clock);
+            uint64_t attached=guest_ns();CHECK(dm_guest_fixed60());CHECK(attached>=before_attach);
+            for(int n=1;n<=17;n++) {
+                dm_guest_frame_begin();dm_guest_frame_tick();
+                CHECK(guest_ns()-attached==(uint64_t)n*UINT64_C(1000000000)/60);
+            }
+        }
+    }else if(argc>1){
+        setenv("DM_DETCLOCK","10",1);dm_guest_frame_tick();uint64_t initial=guest_ns();
+        dm_guest_frame_tick();CHECK(guest_ns()==initial+10);CHECK(dm_detclock_enabled());
+        uint64_t held=guest_ns();guest_clock_freeze_for(3,1);dm_guest_frame_tick();CHECK(guest_ns()==held);
+        guest_clock_freeze_for(1,1);guest_clock_freeze_for(3,0);dm_guest_frame_tick();CHECK(guest_ns()==held);
+        guest_clock_freeze_for(1,0);dm_guest_frame_tick();CHECK(guest_ns()>held);
+    }else{
+        unsetenv("DM_DETCLOCK");uint64_t start=guest_ns();usleep(2000);
+        CHECK(guest_ns()>start);CHECK(!dm_detclock_enabled());
+        dm_rl_clock *clock=mmap(NULL,sizeof *clock,PROT_READ|PROT_WRITE,MAP_SHARED|MAP_ANON,-1,0);
+        CHECK(clock!=MAP_FAILED);clock->magic=DM_RL_CLOCK_MAGIC;
+        atomic_init(&clock->state,0);atomic_init(&clock->last,start);
+        CHECK(atomic_is_lock_free(&clock->state));dm_guest_clock_share(clock);
+        CHECK(!dm_detclock_enabled());uint64_t running=guest_ns();usleep(2000);CHECK(guest_ns()>running);
+        uint64_t held=dm_rl_clock_pause(clock);usleep(30000);CHECK(guest_ns()==held);
+        uint64_t frame=dm_guest_frame();for(int n=0;n<7;n++)dm_guest_frame_tick();
+        CHECK(dm_guest_frame()==frame+7);CHECK(guest_ns()==held);
+        pid_t pid=fork();
+        if(!pid){if(guest_ns()!=held)_exit(1);dm_rl_clock_resume(clock);usleep(2000);_exit(guest_ns()>held?0:2);}
+        int status;waitpid(pid,&status,0);CHECK(WIFEXITED(status)&&WEXITSTATUS(status)==0);
+        CHECK(guest_ns()>held);dm_rl_clock_pause(clock);uint64_t paused=guest_ns();
+        usleep(2000);CHECK(guest_ns()==paused);CHECK(paused>=held);
+        dm_guest_clock_share(NULL);munmap(clock,sizeof *clock);
+    }
+    printf("rl-clock: %d checks, %d failed\n",checks,failed);return failed!=0;
+}
diff --git a/dm/host/tests/t_rl_idle.c b/dm/host/tests/t_rl_idle.c
new file mode 100644
index 0000000..bb22766
--- /dev/null
+++ b/dm/host/tests/t_rl_idle.c
@@ -0,0 +1,22 @@
+// An idle native event wait may outlive the timed-wait guard while frames run.
+#include "../dm.h"
+#include <unistd.h>
+int svc_thread(int num,uint64_t *regs);
+uint32_t svc_thread_main_init(void);
+extern int test_fixed60;
+void (*dm_test_cv_after_release)(void);
+static uint32_t write_handle;
+static void *signal_later(void *arg) {
+    (void)arg;struct timespec delay={2,100000000};nanosleep(&delay,NULL);
+    uint64_t regs[32]={write_handle};svc_thread(0x11,regs);return NULL;
+}
+int main(void) {
+    alarm(5);svc_thread_main_init();test_fixed60=1;
+    uint64_t event[32]={0};svc_thread(0x45,event);
+    write_handle=(uint32_t)event[1];uint32_t read_handle=(uint32_t)event[2];
+    pthread_t signaler;pthread_create(&signaler,NULL,signal_later,NULL);
+    uint64_t wait[32]={0};wait[1]=(uint64_t)(uintptr_t)&read_handle;wait[2]=1;wait[3]=UINT64_MAX;
+    uint64_t start=now_ns();svc_thread(0x18,wait);pthread_join(signaler,NULL);
+    if(wait[0]!=0 || now_ns()-start<UINT64_C(2000000000)) return 1;
+    puts("rl-idle: indefinite event wait survived two bounded polls");return 0;
+}
