+// A coordinated snapshot records actual resident clean pages of project-owned
+// immutable files, keyed by backing inode and file offset. Summing process RSS
+// or even footprint's Clean column cannot deduplicate these across processes.
+// Driver-owned GPU memory and mutable guest buffers are explicitly excluded.
+static void dump_shared_pages(const char *path) {
+#if !TARGET_OS_IPHONE
+    char tmp[1200]; snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    FILE *f = fopen(tmp, "w"); if (!f) return;
+    fprintf(f, "# time_ns=%llu page_size=%u\n", (unsigned long long)now_ns(), vm_page_size);
+    vm_address_t a = 0; vm_size_t sz; natural_t depth = 0;
+    const char *rom = getenv("DM_ROMFS"), *msl = getenv("DM_MSL_DIR"), *cache = getenv("DM_PIPELINE_CACHE");
+    for (;;) {
+        vm_region_submap_info_data_64_t in; mach_msg_type_number_t cnt = VM_REGION_SUBMAP_INFO_COUNT_64;
+        if (vm_region_recurse_64(mach_task_self(), &a, &sz, &depth, (vm_region_recurse_info_t)&in, &cnt) != KERN_SUCCESS) break;
+        if (in.is_submap) { depth++; continue; }
+        char file[PROC_PIDPATHINFO_MAXSIZE]; struct stat st;
+        if (in.external_pager && in.pages_resident && proc_regionfilename(getpid(), a, file, sizeof file) > 0 &&
+            (strstr(file, ".patched.bin") || (rom && !strncmp(file, rom, strlen(rom))) || (msl && !strncmp(file, msl, strlen(msl))) || (cache && !strncmp(file, cache, strlen(cache)))) && !stat(file, &st)) {
+            for (uint64_t off = 0; off < sz; off += vm_page_size) {
+                int disposition, refs;
+                if (mach_vm_page_query(mach_task_self(), a + off, &disposition, &refs) == KERN_SUCCESS &&
+                    (disposition & (VM_PAGE_QUERY_PAGE_PRESENT | VM_PAGE_QUERY_PAGE_EXTERNAL)) == (VM_PAGE_QUERY_PAGE_PRESENT | VM_PAGE_QUERY_PAGE_EXTERNAL) &&
+                    !(disposition & (VM_PAGE_QUERY_PAGE_DIRTY | VM_PAGE_QUERY_PAGE_COPIED)))
+                    fprintf(f, "%llu\t%llu\t%llu\t%d\t%s\n", (unsigned long long)st.st_dev, (unsigned long long)st.st_ino,
+                            (unsigned long long)(in.offset + off), refs, file);
+            }
+        }
