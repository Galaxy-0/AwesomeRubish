+    if (copy) {
+        NVNcommandBuffer dst; h_nvnCommandBufferInitialize(&dst,NULL);
+        h_nvnCommandBufferAddCommandMemory(&dst,(const NVNmemoryPool *)&pool,16384,16384);
+        h_nvnCommandBufferBeginRecording(&dst); h_nvnCommandBufferCopyCommands(&dst,1,&h);
+        h=h_nvnCommandBufferEndRecording(&dst);
