--- /dev/null
+++ b/dm/gfx/nvn/nvn_cmdwatch.c
@@ -0,0 +1,210 @@
+// DM_NVN_CMDWATCH=<first frame>: inventory reachable CALL/JUMP records, hash
+// each record, and protect its pages until CPU replay ends. The first write
+// terminates through the ordinary crash reporter (writer PC/LR/backtrace).
+// DM_NVN_CMDWATCH_HASH=1 retains hashes only, for shared-page investigations.
+#include "../../host/dm.h"
+#include "nvn_obj.h"
+#include "nvn_hmap.h"
+#include "nvn_cmdwatch.h"
+#include <stdatomic.h>
+#include <sys/mman.h>
+#include <sys/ucontext.h>
+#include <unistd.h>
+
+typedef struct { uintptr_t lo, hi; } cw_span;
+typedef struct { uint32_t size; uint64_t hash; } cw_record;
+static cw_span *g_grants; static size_t g_ngrant, g_cgrant;
+static pthread_mutex_t g_grant_mu = PTHREAD_MUTEX_INITIALIZER;
+static cw_span g_ranges[65536]; static size_t g_nrange;
+static uintptr_t g_pages[131072]; static size_t g_npage, g_page_size;
+static nvn_hmap g_records = {.klen=8}, g_seen = {.klen=8};
+typedef struct {uintptr_t end,caller,thread;uint64_t frame,head;} cw_creation;
+static nvn_hmap g_created = {.klen=8};
+static _Atomic int g_active, g_pubkind;
+static _Atomic uint64_t g_pubfence, g_pubaddr, g_replay;
+static uint64_t g_first, g_frame, g_submit;
+static int g_hash_only;
+static _Atomic uintptr_t g_force;
+static _Atomic uintptr_t g_ever[262144];
+static int cw_ever(uintptr_t page,int insert){
+    size_t i=(page/g_page_size*2654435761u)&262143;
+    for(size_t n=0;n<262144;n++,i=(i+1)&262143){
+        uintptr_t p=atomic_load(&g_ever[i]);if(p==page)return 1;
+        if(!p){if(!insert)return 0;if(atomic_compare_exchange_strong(&g_ever[i],&p,page)||p==page)return 1;}
+    }return 0;
+}
+typedef struct { uintptr_t page,addr,pc,lr,thread,replay; uint64_t frame,submit,fence,pubaddr; int phase,kind,exact; } cw_write;
+static cw_write g_writes[16384]; static _Atomic unsigned g_nwrite;
+static void cw_disarm(void);
+static void cw_history(uintptr_t address) {
+    pthread_mutex_lock(&g_grant_mu);
+    cw_creation *c=nvn_hm_get(&g_created,&address);
+    if(c){LOG("[cmdwatch] created entry=%#lx end=%#lx frame=%llu caller=%#lx thread=%#lx head=%#llx",address,c->end,c->frame,c->caller,c->thread,c->head);
+        module_t *m=module_of((void *)c->caller);if(m)LOG("[cmdwatch] creator=%s+%#llx",m->name,(uint64_t)c->caller-(uint64_t)m->base);}
+    pthread_mutex_unlock(&g_grant_mu);
+    uintptr_t page=address&~(g_page_size-1);unsigned n=atomic_load(&g_nwrite),printed=0;
+    for(unsigned k=0;k<n&&k<16384&&printed<8;k++){
+        cw_write w=g_writes[(n-1-k)%16384];if(w.page!=page)continue;printed++;
+        LOG("[cmdwatch] writer history target=%#lx phase=%d exact=%d frame=%llu submit=%llu addr=%#lx pc=%#lx lr=%#lx thread=%#lx replay=%#lx last_publish={fence=%llu kind=%d addr=%#llx}",address,w.phase,w.exact,w.frame,w.submit,w.addr,w.pc,w.lr,w.thread,w.replay,w.fence,w.kind,w.pubaddr);
+        module_t *m=module_of((void *)w.pc),*l=module_of((void *)w.lr);
+        if(m)LOG("[cmdwatch] writer pc=%s+%#llx",m->name,(uint64_t)w.pc-(uint64_t)m->base);
+        if(l)LOG("[cmdwatch] writer lr=%s+%#llx",l->name,(uint64_t)w.lr-(uint64_t)l->base);
+    }
+}
+static int cw_fault(void *addr, int is_write, void *uc_) {
+    if (!is_write || !g_first || g_hash_only) return 0;
+    uintptr_t a = (uintptr_t)addr, page = a & ~(g_page_size - 1);
+    uintptr_t forced=atomic_load(&g_force);
+    if(forced && a>=forced && a<forced+8){
+        ucontext_t *u=uc_;char info[256];int z=snprintf(info,sizeof info,"[cmdwatch] JUMP writer addr=%p pc=%#llx lr=%#llx thread=%p frame=%llu\n",addr,u->uc_mcontext->__ss.__pc,u->uc_mcontext->__ss.__lr,(void *)pthread_self(),dm_nvn_frame_count());
+        if(z>0)(void)write(2,info,(size_t)z);
+        static const char note[]="[cmdwatch] CONFIRMED write into cached BEGIN by JUMP payload; normal crash reports actual writer\n";
+        (void)write(2,note,sizeof note-1);return -1;
+    }
+    if(!atomic_load(&g_active))return cw_ever(page,0)&&!mprotect((void *)page,g_page_size,PROT_READ|PROT_WRITE);
+    size_t lo=0, hi=g_npage;
+    while (lo < hi) { size_t mid=(lo+hi)/2; if(g_pages[mid]<page)lo=mid+1;else hi=mid; }
+    if(lo==g_npage || g_pages[lo]!=page)return cw_ever(page,0)&&!mprotect((void *)page,g_page_size,PROT_READ|PROT_WRITE);
+    int exact=0;
+    for(size_t i=0;i<g_nrange;i++)if(a>=g_ranges[i].lo&&a<g_ranges[i].hi){exact=1;break;}
+    ucontext_t *uc = uc_;
+    int phase=atomic_load(&g_active);
+    unsigned wi=atomic_fetch_add(&g_nwrite,1)%16384;
+    g_writes[wi]=(cw_write){page,a,uc->uc_mcontext->__ss.__pc,uc->uc_mcontext->__ss.__lr,(uintptr_t)pthread_self(),atomic_load(&g_replay),g_frame,g_submit,atomic_load(&g_pubfence),atomic_load(&g_pubaddr),phase,atomic_load(&g_pubkind),exact};
+    if(phase==2){mprotect((void *)page,g_page_size,PROT_READ|PROT_WRITE);return 1;}
+    static _Atomic unsigned shared;
+    unsigned count=exact?0:atomic_fetch_add(&shared,1);
+    if(!exact && count>=12){mprotect((void *)page,g_page_size,PROT_READ|PROT_WRITE);return 1;}
+    // write(2) avoids stdio locks on the normal replay thread. No allocation or
+    // mutex is taken here; the normal crash path prints symbolic PC/LR/stack.
+    char b[512]; int n=snprintf(b,sizeof b,
+        "[cmdwatch] WRITE submit=%llu frame=%llu addr=%p pc=%#llx lr=%#llx thread=%p replay=%#llx last_publish={fence=%llu kind=%d addr=%#llx}\n",
+        g_submit,g_frame,addr,uc->uc_mcontext->__ss.__pc,uc->uc_mcontext->__ss.__lr,
+        (void *)pthread_self(),atomic_load(&g_replay),atomic_load(&g_pubfence),
+        atomic_load(&g_pubkind),atomic_load(&g_pubaddr));
+    if(n>0) (void)write(2,b,(size_t)n);
+    for(size_t i=0;i<g_nrange;i++) if(a>=g_ranges[i].lo && a<g_ranges[i].hi) {
+        n=snprintf(b,sizeof b,"[cmdwatch] writer address is INSIDE reachable command segment [%#lx,%#lx)\n",g_ranges[i].lo,g_ranges[i].hi);
+        if(n>0)(void)write(2,b,(size_t)n); break;
+    }
+    if(!exact){
+        static const char shared_note[]="[cmdwatch] shared-page neighbour write; unprotect page, retain per-record hash checks\n";
+        (void)write(2,shared_note,sizeof shared_note-1);
+        mprotect((void *)page,g_page_size,PROT_READ|PROT_WRITE);return 1;
+    }
+    return -1; // fatal even if a later texture dirty-page hook covers this page
+}
+__attribute__((constructor)) static void cw_init(void) {
+    const char *e=getenv("DM_NVN_CMDWATCH"); if(!e)return;
+    g_first=strtoull(e,NULL,0); if(!g_first)g_first=1;
+    g_hash_only=getenv("DM_NVN_CMDWATCH_HASH")!=NULL;
+    g_page_size=(size_t)getpagesize();
+    dm_fault_hook_register(cw_fault);
+}
+void nvn_cmdwatch_grant(const void *mem,size_t size) {
+    if(!g_first || !mem || !size)return;
+    pthread_mutex_lock(&g_grant_mu);
+    if(g_ngrant==g_cgrant){g_cgrant=g_cgrant?g_cgrant*2:256;g_grants=realloc(g_grants,g_cgrant*sizeof *g_grants);if(!g_grants)abort();}
+    g_grants[g_ngrant++]=(cw_span){(uintptr_t)mem,(uintptr_t)mem+size};
+    pthread_mutex_unlock(&g_grant_mu);
+}
+void nvn_cmdwatch_created(const void *begin,const void *end,uint64_t frame,uint64_t caller){
+    if(!g_first)return;
+    uintptr_t key=(uintptr_t)begin;
+    pthread_mutex_lock(&g_grant_mu);
+    cw_creation *c=nvn_hm_get(&g_created,&key);if(!c){c=malloc(sizeof *c);if(!c)abort();nvn_hm_put(&g_created,&key,c);}
+    uint64_t head;memcpy(&head,begin,8);
+    *c=(cw_creation){(uintptr_t)end,caller,(uintptr_t)pthread_self(),frame,head};
+    if((uint32_t)head>=OP_COUNT_ || (head>>32)<8 || ((head>>32)&7))LOG("[cmdwatch] INVALID AT END entry=%p end=%p frame=%llu caller=%#llx head=%#llx",begin,end,frame,caller,head);
+    pthread_mutex_unlock(&g_grant_mu);
+}
+void nvn_cmdwatch_jump(const void *record,const void *target,const void *begin){
+    if(!g_first)return;uintptr_t key=(uintptr_t)record+8;
