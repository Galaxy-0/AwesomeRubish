+    rl_budget_end=frame+frames;atomic_store(&rl_input_repeats,0);
+    pthread_cond_broadcast(&rl_input_cv);
+    pthread_mutex_unlock(&rl_input_mu);
+    atomic_store(&rl_remaining, (int)frames);
+    if (!rl_clock) guest_clock_freeze_for(3, 0);
+}
