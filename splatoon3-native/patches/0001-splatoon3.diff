-        case I_UsedMem:  case I_UsedNonSys:  v = g_heap_cur + 0x4000000 + big_bss_bytes(); break;
+        case I_UsedMem:  case I_UsedNonSys:  v = g_heap_cur + (orig_image_bytes() > 0x6000000 ? orig_image_bytes() : 0x4000000) + big_bss_bytes(); break;   // Splatoon 3: main+sdk are ~130 MB before rewriting, so 64 MB undercounts and SetHeapSize(total - used) overflows the pool; the game also checks System/HeapSize Program against used - heap, so the rewriter's patch area must not count
