diff --git a/dm/gfx/tests/t_render_enable.m b/dm/gfx/tests/t_render_enable.m
new file mode 100644
index 0000000..b98d2e2
--- /dev/null
+++ b/dm/gfx/tests/t_render_enable.m
@@ -0,0 +1,85 @@
+// Real NVN recording -> Metal replay -> pixel readback. No game assets.
+#define nvn_game_fps nvn_game_fps_mtl_default
+#include "../nvn/nvn_mtl.m"
+#undef nvn_game_fps
+#include "../nvn/hle_nvn.c"
+#include "../../host/hle_bigstack.c"
+int dm_guest_as_contains(uintptr_t a) { (void)a; return 0; } // tests run on host stacks
+uint64_t g_t0_ns;
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t g_mod[MAX_MOD]; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(name, ok) do { checks++; if (!(ok)) { failed++; fprintf(stderr,"FAIL %s\n",name); } } while (0)
+static prog_t pg;
+static void run_case(int mode, int enabled, int draw_test, int producer, int copy) {
+    static uint64_t serial = 91000;
+    tex_t t = {.magic=MAGIC('T','E','X',0), .serial=serial++};
+    t.d = (nvn_texdesc){.width=4,.height=4,.depth=1,.levels=1,.samples=1,.target=NVN_TEXTURE_TARGET_2D,.format=NVN_FORMAT_RGBA8};
+    NVNcommandBuffer cb; void *mem; if (posix_memalign(&mem,getpagesize(),65536)) abort(); memset(mem,0,65536);
+    pool_t pool={.mem=mem,.size=65536}; mtl_pool_add(mem,65536);
+    h_nvnCommandBufferInitialize(&cb,NULL); h_nvnCommandBufferAddCommandMemory(&cb,(const NVNmemoryPool *)&pool,0,65536);
+    h_nvnCommandBufferBeginRecording(&cb);
+    const NVNtexture *ct[]={(const NVNtexture *)&t};
+    h_nvnCommandBufferSetRenderTargets(&cb,1,ct,NULL,NULL,NULL);
+    float blue[]={0,0,1,1}, red[]={1,0,0,1};
+    h_nvnCommandBufferSetRenderEnable(&cb,1); h_nvnCommandBufferClearColor(&cb,0,blue,15);
+    // Flush the blue seed before attempting a second clear in the same target.
+    h_nvnCommandBufferSetRenderTargets(&cb,1,ct,NULL,NULL,NULL);
+    // Equal low words with different high words catch 32-bit-only comparisons;
+    // different timestamps catch incorrectly comparing +0 against +8.
+    uint64_t *q=(uint64_t *)((uint8_t *)mem+32768);
+    q[0]=0x100000007ull; q[1]=111; q[2]=mode==0?(enabled?q[0]:0x200000007ull):(enabled?0x200000007ull:q[0]); q[3]=222;
+    if (producer) {
+        q[0]=55; q[2]=0;
+        h_nvnCommandBufferReportCounter(&cb,NVN_COUNTER_TYPE_TIMESTAMP_TOP,(NVNbufferAddress)q);
+    }
+    if (mode<0) h_nvnCommandBufferSetRenderEnable(&cb,enabled);
+    else h_nvnCommandBufferSetRenderEnableConditional(&cb,mode,(NVNbufferAddress)q);
+    if (draw_test) {
+        h_nvnCommandBufferBindProgram(&cb,(const NVNprogram *)&pg,3);
+        h_nvnCommandBufferDrawArrays(&cb,NVN_DRAW_PRIMITIVE_TRIANGLES,0,3);
+    } else h_nvnCommandBufferClearColor(&cb,0,red,15);
+    h_nvnCommandBufferSetRenderEnable(&cb,1);
+    NVNcommandHandle h=h_nvnCommandBufferEndRecording(&cb);
+    if (copy) {
+        NVNcommandBuffer dst; h_nvnCommandBufferInitialize(&dst,NULL);
+        h_nvnCommandBufferAddCommandMemory(&dst,(const NVNmemoryPool *)&pool,16384,16384);
+        h_nvnCommandBufferBeginRecording(&dst); h_nvnCommandBufferCopyCommands(&dst,1,&h);
+        h=h_nvnCommandBufferEndRecording(&dst);
+        // The source command storage and its embedded texture snapshot expire.
+        memset(mem,0xa5,16384);
+    }
+    state_reset(); memset(&R,0,sizeof R); mtl_sub_begin(); mtl_exec((const uint8_t *)h);
+    CHECK("GPU completed",mtl_wait(mtl_sub_commit(),5000000000ull));
+    CHECK("GPU feedback clean",!mtl_last_commit_error());
+    id<MTLTexture> tex=tex_mtl(&t);
+    id<MTLBuffer> out=[g_dev newBufferWithLength:64 options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> read=[g_q commandBuffer]; id<MTLBlitCommandEncoder> b=[read blitCommandEncoder];
+    [b copyFromTexture:tex sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(4,4,1)
+       toBuffer:out destinationOffset:0 destinationBytesPerRow:16 destinationBytesPerImage:64];
+    [b endEncoding]; [read commit]; [read waitUntilCompleted];
+    const uint8_t *px=out.contents; int bad=0;
+    for(int i=0;i<16;i++) bad+=px[i*4]!=(enabled?255:0)||px[i*4+1]!=0||px[i*4+2]!=(enabled?0:255)||px[i*4+3]!=255;
+    CHECK("all 16 pixels match predicate",!bad);
+    if(producer) { CHECK("timestamp top zero payload",q[0]==0); CHECK("timestamp top timestamp",q[1]!=0); }
+    CHECK("direct enable restores state",g_render_enable==1);
+    mtl_tex_release(&t); mtl_pool_del(mem); free(mem);
+}
+int main(void) { @autoreleasepool {
+    setenv("DM_NVN_TBDR","0",1); mtl_init(); NSError *e=nil;
+    id<MTLLibrary> lib=[g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "vertex float4 v(uint n[[vertex_id]]){float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)};return float4(p[n],0,1);}\n"
+        "fragment float4 f(){return float4(1,0,0,1);}\n" options:nil error:&e];
+    if(!lib) { fprintf(stderr,"%s\n",e.localizedDescription.UTF8String); return 2; }
+    NvProg *p=[NvProg new]; p->sh[0]=[NvShader new];p->sh[0]->fn=[lib newFunctionWithName:@"v"];
+    p->sh[1]=[NvShader new];p->sh[1]->fn=[lib newFunctionWithName:@"f"];p->sh[1]->stage=1;
+    pg.serial=90000;serial_put(pg.serial,p);
+    for(int copy=0;copy<=1;copy++) {
+        for(int mode=-1;mode<=1;mode++)for(int en=0;en<=1;en++)for(int draw=0;draw<=1;draw++)run_case(mode,en,draw,0,copy);
+        run_case(1,0,0,1,copy); // same-submit timestamp producer must be resolved before comparison
+    }
+    printf("render-enable: %d checks, %d failed\n",checks,failed);return failed!=0;
+} }
