+// One immutable action per present interval, however many SDK callers query it.
+int dm_rl_input(uint64_t frame, dm_rl_action_t *action) {
+    if (!dm_rl_active()) return 0;
+    pthread_mutex_lock(&rl_input_mu);
+    int auto_frame=frame==UINT64_MAX;
+    if (auto_frame) frame=dm_guest_frame();
+    // A query at the completed budget endpoint belongs to the next frame.
+    // It waits for the next STEP, just like the present thread, rather than
+    // inventing an action or rejecting normal concurrent SDK polling.
+    while (dm_rl_active() && frame==rl_budget_end) {
+        // This is a policy/budget pause, not an execution stall.
+        pthread_cond_wait(&rl_input_cv,&rl_input_mu);
+        if(auto_frame)frame=dm_guest_frame();
+    }
+    if (!dm_rl_active()) { pthread_mutex_unlock(&rl_input_mu);return 0; }
+    uint64_t current=atomic_load(&rl_frame), previous=atomic_load(&rl_last_input);
+    if (frame<rl_input_floor || frame>rl_budget_end)
+        die("RL input frame outside budget/backwards current=%llu actual=%llu previous=%llu end=%llu",current,frame,previous,rl_budget_end);
+    if (frame!=previous) {
+        rl_latched=rl_pending;
+        if (atomic_load(&rl_phase)>=2) memset(&rl_latched,0,sizeof rl_latched);
+        dm_hid_rl_action(rl_latched.buttons,rl_latched.axes,rl_latched.gyro);
+        atomic_store(&rl_last_input,frame);
+        atomic_store(&rl_input_seen[frame&4095],frame);
+    } else atomic_fetch_add(&rl_input_repeats,1);
+    rl_input_floor=frame;
+    *action=rl_latched;
+    pthread_mutex_unlock(&rl_input_mu);
+    return 1;
+}
+void dm_rl_before_input(uint64_t frame) { dm_rl_action_t action;dm_rl_input(frame,&action); }
+// Called after every native present, outside graphics locks. Missing HID reads
+// (loading/results) are normal frames and never bypass the step boundary.
+void dm_rl_present(uint64_t frame) {
+    if (!atomic_load(&rl_enabled) || !frame) return;
+    if (rl_peer < 0) {
+        rl_peer = accept(rl_listener, NULL, NULL);
+        if (rl_peer < 0) {
+            if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) die("RL accept: %s", strerror(errno));
+            return;
+        }
+        if (fcntl(rl_peer, F_SETFL, 0) < 0) die("RL connected socket flags");
+#ifdef SO_NOSIGPIPE
+        int one = 1; setsockopt(rl_peer, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
