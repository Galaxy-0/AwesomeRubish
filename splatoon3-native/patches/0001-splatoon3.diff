+        if (size + orig_image_bytes() > APP_POOL) { regs[0] = 0x10801; return 0; }   // exceeds the application memory pool: ResultLimitReached. At startup the game retries in 2 MB decrements until it fits (main+0x1b66184)
         int rc = 0;
         if (size > g_heap_cur) rc = mprotect(g_heap + g_heap_cur, size - g_heap_cur, PROT_READ | PROT_WRITE);
         else if (size < g_heap_cur) rc = mprotect(g_heap + size, g_heap_cur - size, PROT_NONE);
@@ -226,7 +228,7 @@ uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr) {
         case I_AslrAddr:  v = (uint64_t)g_as;    break;   case I_AslrSize:  v = RESERVE;     break;
         case I_StackAddr: v = (uint64_t)g_stack; break;   case I_StackSize: v = g_stack_cap; break;
         case I_TotalMem: case I_TotalNonSys: v = APP_POOL; break;
-        case I_UsedMem:  case I_UsedNonSys:  v = g_heap_cur + 0x4000000 + big_bss_bytes(); break;
+        case I_UsedMem:  case I_UsedNonSys:  v = g_heap_cur + (orig_image_bytes() > 0x6000000 ? orig_image_bytes() : 0x4000000) + big_bss_bytes(); break;   // Splatoon 3: main+sdk are ~130 MB before rewriting, so 64 MB undercounts and SetHeapSize(total - used) overflows the pool; the game also checks System/HeapSize Program against used - heap, so the rewriter's patch area must not count
         case I_SysResTotal: v = 0x2000000; break; case I_SysResUsed: v = 0x400000; break;
         case I_DebuggerAttached: v = 0; break;
         case I_RandomEntropy: { uint64_t dm_entropy64(void); v = dm_entropy64(); break; }   // a deterministic stream when DM_DETCLOCK is on (hle_os.c)
diff --git a/dm/host/hle_thread.c b/dm/host/hle_thread.c
