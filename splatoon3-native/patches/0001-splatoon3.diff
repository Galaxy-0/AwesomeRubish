+// Real DM_KEYS parse -> virtual controller -> SDK HID state, with a fake clock.
+#include "../hle_hid.c"
+static uint64_t test_ns=1000000000ull;
+uint64_t now_ns(void){return test_ns;}
+uint64_t dm_guest_frame(void){return 0;}
+int dm_opmode(void){return 1;}
+void hle_bind_system_event(void *p,int n){(void)p;(void)n;}
+void hle_signal_system_event(void *p){(void)p;}
+static int checks,failed;
+#define CHECK(ok) do{checks++;if(!(ok)){failed++;fprintf(stderr,"FAIL line %d\n",__LINE__);}}while(0)
+int main(void){
+    uint32_t handle=0;SixState motion;
+    CHECK(h_hid_SixStates(&motion,1,&handle)==0);
+    keys_parse("f120:RLeft+RUp+ZR~0.5,f180:GUp~2.5,f400:A");
+    CHECK(g_nsteps==3&&g_steps[0].frame&&g_steps[0].at==120);
+    CHECK(g_steps[0].hold==.5&&g_steps[0].rx==-32767&&g_steps[0].ry==32767);
+    keys_apply(&g_steps[0],1);NpadState s;fill(&s,0,STYLE_FULLKEY);
+    CHECK(s.rx==-32767&&s.ry==32767&&s.lx==0&&s.ly==0);
+    CHECK((s.buttons&DM_BTN_ZR)!=0&&(s.buttons&DM_BTN_R)==0);
+    keys_apply(&g_steps[0],0);fill(&s,0,STYLE_FULLKEY);CHECK(s.rx==0&&s.ry==0&&s.buttons==0);
+    h_hid_SixStart(&handle);CHECK(h_hid_SixStates(&motion,1,&handle)==1&&motion.attributes==1);
+    CHECK(motion.direction[0][0]==1&&motion.direction[1][1]==1&&motion.direction[2][2]==1);
+    keys_apply(&g_steps[1],1);test_ns+=2500000000ull;
+    h_hid_SixState(&motion,&handle);
+    CHECK(fabs(motion.angle[0]-.25f)<1e-5&&fabs(motion.velocity[0]-.1f)<1e-5);
+    CHECK(fabs(motion.direction[1][2]+1)<1e-5&&fabs(motion.direction[2][1]-1)<1e-5);
+    CHECK(h_hid_SixRest(&handle)==0&&motion.sampling>1&&motion.delta_time==MOTION_PERIOD_NS);
+    keys_apply(&g_steps[1],0);test_ns+=1000000000ull;h_hid_SixState(&motion,&handle);
+    CHECK(fabs(motion.angle[0]-.25f)<1e-5&&motion.velocity[0]==0&&h_hid_SixRest(&handle));
+    for(int a=0;a<3;a++)for(int b=0;b<3;b++){float dot=0;for(int j=0;j<3;j++)dot+=motion.direction[a][j]*motion.direction[b][j];CHECK(fabs(dot-(a==b))<1e-5);}
+    // Real caller requests sixteen and ignores the returned count. Every entry
+    // must carry valid acceleration and orientation, not fifteen zero records.
+    SixState history[16];
+    CHECK(h_hid_SixStates(history,16,&handle)==16);
+    for(int i=0;i<16;i++){
+        CHECK(history[i].attributes==1&&history[i].delta_time==MOTION_PERIOD_NS);
+        float norm=0;for(int j=0;j<3;j++)norm+=history[i].acceleration[j]*history[i].acceleration[j];
+        CHECK(fabsf(norm-1)<1e-5);
+        if(i)CHECK(history[i-1].sampling==history[i].sampling+1);
+    }
+    uint64_t sample=history[0].sampling;
+    CHECK(h_hid_SixStates(history,16,&handle)==16&&history[0].sampling==sample);
+    test_ns+=MOTION_PERIOD_NS;
+    CHECK(h_hid_SixStates(history,16,&handle)==16&&history[0].sampling==sample+1);
+    CHECK(h_hid_SixStates(history,0,&handle)==0);
+    h_hid_SixStop(&handle);CHECK(h_hid_SixStates(&motion,1,&handle)==0);
+    printf("hid-motion: %d checks, %d failed\n",checks,failed);return failed!=0;
+}
diff --git a/dm/host/tests/t_ldn_frontend.c b/dm/host/tests/t_ldn_frontend.c
