index 0000000..e839147
--- /dev/null
+++ b/dm/host/tests/t_ldn_frontend.c
@@ -0,0 +1,27 @@
+// The opt-in local frontend can initialize, but cannot claim peer connectivity.
+#include "../hle_ldn.c"
+module_t g_mod[MAX_MOD]; int g_nmod;
+void hle_forget_system_event(void *ev) { (void)ev; }
+void hle_bind_system_event(void *ev, int autoclear) { (void)ev; (void)autoclear; }
+void hle_signal_system_event(void *ev) { (void)ev; }
+static int checks, failures;
+#define CHECK(label, condition) do { checks++; if (!(condition)) { failures++; fprintf(stderr, "FAIL %s\n", label); } } while (0)
+int main(void) {
+    g_nmod = 1; strcpy(g_mod[0].name, "main");
+    strcpy(g_mod[0].build_id, "28c4287aee36f7499da60f3e68b54c70");
+    unsetenv("DM_LDN_FRONTEND"); unsetenv("DM_LDN_AIR");
+    CHECK("default remains offline", h_ldn_Init() == RES_FAIL && h_ldn_State() == 0);
+    setenv("DM_LDN_FRONTEND", "1", 1);
+    CHECK("frontend initializes an idle service", h_ldn_Init() == RES_OK && h_ldn_State() == 1);
+    CHECK("NX protocol configuration succeeds", h_ldn_Protocol(1) == RES_OK);
+    CHECK("unsupported protocol is rejected", h_ldn_Protocol(2) == RES_FAIL);
+    CHECK("station is not connected", h_ldn_OpenSta() == RES_FAIL && h_ldn_State() == 1);
+    CHECK("no access point is created", h_ldn_OpenAp() == RES_FAIL && h_ldn_State() == 1);
+    CHECK("network creation stays unavailable", h_ldn_Create(NULL, NULL, NULL) == RES_FAIL);
+    CHECK("peer connection stays unavailable", h_ldn_Connect(NULL, NULL, NULL, 0, 0) == RES_FAIL);
+    h_ldn_Fini(); CHECK("finalize clears the service", h_ldn_State() == 0);
+    strcpy(g_mod[0].build_id, "unknown");
+    CHECK("unknown build remains offline", h_ldn_Init() == RES_FAIL && h_ldn_State() == 0);
+    printf("ldn-frontend: %d checks, %d failed\n", checks, failures);
+    return failures != 0;
+}
