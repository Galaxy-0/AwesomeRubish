+void hle_signal_system_event(void *ev) { (void)ev; }
+static int checks, failures;
+#define CHECK(label, condition) do { checks++; if (!(condition)) { failures++; fprintf(stderr, "FAIL %s\n", label); } } while (0)
+int main(void) {
+    g_nmod = 1; strcpy(g_mod[0].name, "main");
+    strcpy(g_mod[0].build_id, "28c4287aee36f7499da60f3e68b54c70");
