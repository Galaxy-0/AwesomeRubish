+    {0x4401f18, 0xd503201f, 0xb50000b4, "gear categories retain native filter"},
+    {0x4401f1c, 0xd503201f, 0xf9400408, "unwrap native catalog row"},
+    {0x4401f20, 0x91002108, 0xb9405108, "read weapon catalog type"},
+    {0x4401f24, 0xf9400108, 0x35fff288, "skip non-Versus rows"},
+    {0x4401f28, 0xb4fff1c8, 0xd503201f, "type guard padding"},
+    {0x4401f2c, 0xb9402109, 0xf9400008, "resume catalog ID getter"},
+    {0x4401f30, 0x6b1a013f, 0x17ffffc7, "resume native catalog loop"},
+};
+void spl3_unlock_install(void) {
+    const char *e = getenv("DM_FULL_UNLOCK");
+    if (!e || !strcmp(e, "0")) return;
+    if (strcmp(e, "1")) die("DM_FULL_UNLOCK must be 0 or 1");
+    if (strcmp(dm_main_build(), "28c4287aee36f7499da60f3e68b54c70"))
+        die("DM_FULL_UNLOCK requires the verified Splatoon 3 11.3.0 main build");
+    module_t *m = NULL;
+    for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) m = &g_mod[i];
+    if (!m) die("DM_FULL_UNLOCK missing main");
+    // Validate the whole set before writing any instruction.
+    for (unsigned i = 0; i < sizeof ownership_cuts / sizeof *ownership_cuts; i++) {
+        const spl3_cut *c = &ownership_cuts[i];
+        if (c->offset + 4 > m->text_end || *(uint32_t *)(m->base + c->offset) != c->expected)
+            die("DM_FULL_UNLOCK instruction mismatch at main+%x", c->offset);
+    }
+    for (unsigned i = 0; i < sizeof ownership_cuts / sizeof *ownership_cuts; i++) {
+        const spl3_cut *c = &ownership_cuts[i];
+        void *page = (void *)((uintptr_t)(m->base + c->offset) & ~(uintptr_t)0x3fff);
+        if (mprotect(page, 0x4000, PROT_READ | PROT_WRITE)) die("DM_FULL_UNLOCK mprotect write");
+        *(uint32_t *)(m->base + c->offset) = c->replacement;
+        if (mprotect(page, 0x4000, PROT_READ | PROT_EXEC)) die("DM_FULL_UNLOCK mprotect execute");
+        sys_icache_invalidate(m->base + c->offset, 4);
+        LOG("SPL3_UNLOCK main+%x %s", c->offset, c->reason);
+    }
+}
+
+// The local player parameter constructor reads the selected weapon twice:
+// first to build the native main/sub/special kit at +0x78, then to look up its
+// proficiency. Override those *reads*, never the save object. Remote player
+// parameters still arrive through PIA. The harness validates Versus catalog
+// membership and observes the resulting native kit at x21+0xe8.
+void spl3_weapon_install(void) {
+    const char *e = getenv("DM_WEAPON"); if (!e) return;
+    char *end; long id = strtol(e, &end, 10);
+    if (!*e || *end || id < 0 || id > 65535) die("DM_WEAPON must be a catalog weapon ID (0..65535)");
+    if (strcmp(dm_main_build(), "28c4287aee36f7499da60f3e68b54c70")) die("DM_WEAPON requires verified Splatoon 3 11.3.0 main");
+    module_t *m = NULL;
+    for (int i = 0; i < g_nmod; i++) if (!strcmp(g_mod[i].name, "main")) m = &g_mod[i];
+    uint32_t offsets[] = {0x3571e1c, 0x3571e24};
+    uint32_t expected[] = {0xb94196e1, 0xb94196e8};
+    uint32_t replacement[] = {0x52800001 | ((uint32_t)id << 5), 0x52800008 | ((uint32_t)id << 5)};
+    for (int i = 0; i < 2; i++) if (!m || offsets[i]+4 > m->text_end || *(uint32_t *)(m->base+offsets[i]) != expected[i]) die("DM_WEAPON signature mismatch");
+    void *page = m->base + (offsets[0] & ~0x3fffu);
+    if (mprotect(page, 0x4000, PROT_READ | PROT_WRITE)) die("DM_WEAPON mprotect write");
+    for (int i = 0; i < 2; i++) *(uint32_t *)(m->base+offsets[i]) = replacement[i];
+    if (mprotect(page, 0x4000, PROT_READ | PROT_EXEC)) die("DM_WEAPON mprotect execute");
+    sys_icache_invalidate(page, 0x4000);
+    LOG("SPL3_WEAPON requested=%ld local_kit_reads=2 save_writes=0", id);
+}
