+#include "../dm_rl.h"
+#include <math.h>
+static uint64_t test_ns=1000000000,frame=1,applied=UINT64_MAX;
+static dm_rl_action_t action={.buttons=512,.axes={12345,-23456,3000,-4000},.gyro={.1f,0,0}};
+uint64_t now_ns(void){return test_ns;}
+uint64_t guest_ns(void){return test_ns;}
+uint64_t dm_guest_frame(void){return frame;}
+int dm_opmode(void){return 1;}
+int dm_rl_active(void){return 1;}
+int dm_rl_input(uint64_t f,dm_rl_action_t *out){
+    if(f==UINT64_MAX)f=frame;
+    if(applied!=f){dm_hid_rl_action(action.buttons,action.axes,action.gyro);applied=f;}
+    *out=action;return 1;
+}
+void hle_bind_system_event(void *p,int n){(void)p;(void)n;}
+void hle_signal_system_event(void *p){(void)p;}
+void dm_input_set(uint64_t,int32_t,int32_t,int32_t,int32_t);
+void dm_pad_set(uint64_t,int32_t,int32_t,int32_t,int32_t);
+typedef struct {int64_t sample;uint64_t buttons;int32_t axes[4];uint32_t attrs,pad;} Npad;
+static int (*h_hid_StatesFullKey)(Npad *,int,const uint32_t *);
+static void (*h_hid_SixStart)(const uint32_t *);
+// SixState's public ABI: timestamps + acceleration/angular velocity/angle + matrix.
+typedef struct {int64_t delta,sample;float accel[3],rate[3],angle[3],direction[3][3];uint32_t attrs,pad;} Six;
+static int (*h_hid_SixStates)(Six *,int,const uint32_t *);
+static void *lookup(const char *name){
+    unsigned long size;const hle_force_ent *entries=(const void *)getsectiondata(&_mh_execute_header,"__DATA","swforce",&size);
+    for(unsigned i=0;i<size/sizeof *entries;i++)if(!strcmp(entries[i].name,name))return entries[i].fn;
+    abort();
+}
+static int checks,failed;
+#define CHECK(x) do{checks++;if(!(x)){failed++;fprintf(stderr,"FAIL %d\n",__LINE__);}}while(0)
+int main(void){
+    h_hid_StatesFullKey=lookup("_ZN2nn3hid13GetNpadStatesEPNS0_16NpadFullKeyStateEiRKj");
+    h_hid_SixStart=lookup("_ZN2nn3hid18StartSixAxisSensorERKNS0_19SixAxisSensorHandleE");
+    h_hid_SixStates=lookup("_ZN2nn3hid22GetSixAxisSensorStatesEPNS0_18SixAxisSensorStateEiRKNS0_19SixAxisSensorHandleE");
+    setenv("DM_RL_SOCKET","test",1);uint32_t id=0;Npad a,b;Six first,second;
+    CHECK(h_hid_StatesFullKey(&a,1,&id)==1);
+    // Physical/keyboard changes between queries cannot override the RL payload.
+    dm_input_set(2,-32767,32767,32767,32767);dm_pad_set(4,0,0,0,0);
+    CHECK(h_hid_StatesFullKey(&b,1,&id)==1);
+    CHECK(a.buttons==b.buttons&&memcmp(a.axes,b.axes,sizeof a.axes)==0);
+    CHECK(a.axes[0]==12345&&a.axes[1]==-23456&&(a.buttons&512));
+    h_hid_SixStart(&id);CHECK(h_hid_SixStates(&first,1,&id)==1);
+    test_ns+=100000000;CHECK(h_hid_SixStates(&second,1,&id)==1);
+    CHECK(memcmp(&first,&second,sizeof first)==0);
+    frame++;test_ns+=100000000;CHECK(h_hid_SixStates(&second,1,&id)==1);
+    CHECK(second.sample>first.sample);CHECK(second.angle[0]>first.angle[0]);
+    CHECK(fabsf(second.rate[0]-.1f)<1e-6);
+    printf("hid-rl: %d checks, %d failed\n",checks,failed);return failed!=0;
+}
