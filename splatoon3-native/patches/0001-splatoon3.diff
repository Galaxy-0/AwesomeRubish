+// Production transport with independent present and HID scheduling; no game.
+#include "../dm.h"
+#include "../dm_rl.h"
+#include "../dm_rl_clock.h"
+#include <unistd.h>
+#include <stdatomic.h>
+#include <math.h>
+module_t g_mod[MAX_MOD]; int g_nmod=1;
+static uint64_t buttons, test_frame, apply_count;static int32_t sticks[4];static int frozen;
+static void (*callbacks[OBS_MAX])(const uint64_t *);
+void dm_guest_clock_share(struct dm_rl_clock *clock) {(void)clock;}
+void dm_guest_clock_release(void) {}
+uint64_t guest_ns(void){return test_frame*16666667ull;}
+uint64_t dm_guest_frame(void) { return test_frame; }
+int gate_obs_present(int n) { return n>=21 && n<=30; }
+void gate_obs_set(int n,void (*fn)(const uint64_t *)) { callbacks[n]=fn; }
+void guest_clock_freeze_for(int reason,int on) { if(reason!=3)abort();frozen=on; }
+void dm_hid_rl_action(uint64_t b,const int32_t a[4],const float g[3]) { (void)g;apply_count++;buttons=b;memcpy(sticks,a,sizeof sticks); }
+static void *boundary_query(void *arg) {
+    dm_rl_action_t action;dm_rl_input((uint64_t)(uintptr_t)arg,&action);return NULL;
+}
+int main(int argc,char **argv) {
+    if(argc<2)return 2;const char *mode=argc>2?argv[2]:"";
+    strcpy(g_mod[0].name,"main");strcpy(g_mod[0].build_id,"28c4287aee36f7499da60f3e68b54c70");
+    setenv("DM_RL_SOCKET",argv[1],1);dm_rl_init();
+    uint8_t rgb[DM_RL_BYTES]={0},state[0x1f0]={0};float position[3]={13.25f,-2,7},ink=.625f,facing[3]={0,0,-1};
+    uint64_t regs[31]={(uint64_t)(uintptr_t)state};
+    if(!strcmp(mode,"invalid")){position[0]=NAN;ink=INFINITY;facing[0]=NAN;}
+    float view[3]={1,0,0},pitch=.2f;
+    if(!strcmp(mode,"invalid-view")){view[0]=NAN;pitch=INFINITY;}
+    memcpy(state+0x5c,view,sizeof view);memcpy(state+0x68,&pitch,4);
+    memcpy(state+0x20,position,sizeof position);memcpy(state+0x84,&ink,sizeof ink);memcpy(state+0x44,facing,sizeof facing);callbacks[OBS_SPL3_INGAME](regs);
+    uint8_t roots[2][0x110]={{0}},infos[2][0x800]={{0}},stores[2][16]={{0}},nodes[2][0x188]={{0}},damage[0xf08]={0};
+    for(int i=0;i<2;i++) {
+        uintptr_t storage=(uintptr_t)stores[i],info=(uintptr_t)infos[i];int slot=i?4:0;
+        if(!strcmp(mode,"bad-slot") && !i)slot=99;
+        memcpy(roots[i]+0x108,&storage,8);memcpy(stores[i]+8,&info,8);memcpy(infos[i]+0x7e8,&slot,4);
+    }
+    uintptr_t own=(uintptr_t)roots[0];memcpy(damage+0xf00,&own,8);
+    uint64_t controlled=0;pthread_t boundary_thread;int boundary_started=0;
+    for(uint64_t frame=1;;frame++) {
+        // Input for the interval from present N to N+1 uses frame N.
+        if(dm_rl_active()) {
+            controlled++;
+            if(!strcmp(mode,"slow"))usleep(100000);
+            if(!strcmp(mode,"stall")) for(;;)usleep(10000);
+            if (!strcmp(mode,"score-reset") && controlled==2) callbacks[OBS_SPL3_INGAME](regs);
+            if (strstr(mode,"score") && controlled==1) callbacks[OBS_SPL3_JUDGE](regs);
+            if(!strcmp(mode,"settled")&&controlled==2)callbacks[OBS_SPL3_JUDGE](regs);
+            if(strcmp(mode,"no-input")) {
+                uint64_t input=test_frame;
+                if(!strcmp(mode,"early"))input--;
+                if(!strcmp(mode,"future"))input+=100;
+                dm_rl_action_t first,second;dm_rl_input(input,&first);
+                if(!strcmp(mode,"duplicate")) {
+                    uint64_t count=apply_count;
+                    // A phase callback or external controller must not change
+                    // the action returned by a second query in this frame.
+                    buttons=0;dm_rl_input(input,&second);
+                    if(memcmp(&first,&second,sizeof first)||apply_count!=count)abort();
+                    buttons=second.buttons;
+                }
+            }
+        }
+        if(!strcmp(mode,"boundary") && controlled==1) {
+            test_frame=frame;
+            if(pthread_create(&boundary_thread,NULL,boundary_query,(void *)(uintptr_t)UINT64_MAX))abort();
+            boundary_started=1;
+        }
+        memset(rgb,buttons?191:(sticks[0]?113:17),sizeof rgb);
+        uint32_t damage_sequence[]={1000,570,0,1000};
+        uint32_t health=!strcmp(mode,"invalid") ? 1001 : !strcmp(mode,"damage") ? damage_sequence[controlled%4] : 1000;
+        uint32_t charge_sequence[]={0,49,100,0};
+        uint32_t special=!strcmp(mode,"invalid") ? 101 : !strcmp(mode,"charge") ? charge_sequence[controlled%4] : 0;
+        memcpy(state+0x80,&special,4);memcpy(state+0x70,&health,4);test_frame=frame;callbacks[OBS_SPL3_LOCAL_STATE](regs);
+        if(!strcmp(mode,"motion")) {
+            uint32_t forms[]={1,0,0,0},contacts[]={4,4,0,5};
+            memcpy(state+0xf8,&forms[controlled%4],4);memcpy(state+0x94,&contacts[controlled%4],4);
+            callbacks[OBS_SPL3_LOCAL_STATE](regs);
+        }
+        uint64_t own_regs[31]={(uintptr_t)damage};callbacks[OBS_SPL3_OWN_PLAYER](own_regs);
+        for(int i=0;i<2;i++) {
+            int status=!i && !strcmp(mode,"hud-down") && controlled==1 ? 1 : !i && !strcmp(mode,"hud-absent") && controlled==1 ? 2 : 0;
+            memcpy(nodes[i]+0x140,&status,4);
+            nodes[i][0x166]=!strcmp(mode,"hud-ready") && i==1;
+            uint64_t bind_regs[31]={0};bind_regs[19]=(uintptr_t)nodes[i];bind_regs[20]=(uintptr_t)roots[i];callbacks[OBS_SPL3_HUD_BIND](bind_regs);
+            uint64_t hud_regs[31]={0};hud_regs[19]=(uintptr_t)nodes[i];callbacks[OBS_SPL3_HUD_STATE](hud_regs);
+        }
+        uint8_t timer[0x150]={0};float raw=!strcmp(mode,"invalid") ? NAN : 10800-frame;int scale=60;
+        memcpy(timer+0x140,&raw,4);memcpy(timer+0x14c,&scale,4);timer[0x148]=1;
+        uint64_t timer_regs[31]={(uint64_t)(uintptr_t)timer};callbacks[OBS_SPL3_TIMER](timer_regs);
+        uint64_t score_regs[31]={0};score_regs[3]=!strcmp(mode,"invalid-score")?1001:!strcmp(mode,"rule-score")?100:42;score_regs[4]=!strcmp(mode,"rule-score")?30:18;
+        callbacks[!strcmp(mode,"rule-score")?OBS_SPL3_RULE_SCORE:OBS_SPL3_TURF_SCORE](score_regs);
+        dm_rl_pixels(rgb,frame,1280,720);dm_rl_present(frame);
+        if(boundary_started) { pthread_join(boundary_thread,NULL);boundary_started=0; }
+        if(frozen)abort();
+        usleep(1000);
+    }
+}
