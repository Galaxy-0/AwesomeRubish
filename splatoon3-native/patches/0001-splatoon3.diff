diff --git a/dm/host/hle_spl3_gear.c b/dm/host/hle_spl3_gear.c
new file mode 100644
index 0000000..0877bf7
--- /dev/null
+++ b/dm/host/hle_spl3_gear.c
@@ -0,0 +1,91 @@
+// Build-gated read adapter for an already owned, selected local gear item.
+// The game constructs/equips its kit normally from the adapted owned-row read.
+// Save objects, remote kits and the native ownership checks stay untouched.
+#include "dm.h"
+#include <errno.h>
+
+// 1 = owned-row read, 2 = identity diagnostic, 3 = old-field diagnostic.
+static int gear_mode, gear_wanted[3][4];
+static _Thread_local struct { unsigned char row[0x68]; int subs[3]; } gear_views[3];
+static int gear_get(const void *p,unsigned offset) { int value;memcpy(&value,(const char *)p+offset,4);return value; }
+static void gear_put(void *p,unsigned offset,int value) { memcpy((char *)p+offset,&value,4); }
+static int gear_main_allowed(int piece,int skill) {
+    return skill<=14 || (piece==0 && skill<=18) || (piece==1 && skill>=19 && skill<=23) || (piece==2 && skill>=24);
+}
+static void gear_owned_read(const uint64_t *r) {
+    int piece=(int)r[23];if(piece<0 || piece>2)return;
+    const void *owned=(const void *)(uintptr_t)r[0];
+    // At main+3572074 the selected ID has already been found in this local
+    // save's owned-gear tree. Native 34b1e00 reads only +40..+60 from this row
+    // and never retains its pointer. Give that read a thread-local view, with
+    // the same ID/experience and three legal skills, then let its normal copy
+    // and enum setters build the complete transmitted/equipped parameters.
+    int capacity=gear_get(owned,0x58),begin=gear_get(owned,0x5c),count=gear_get(owned,0x60);
+    if(capacity<3 || capacity>16 || begin<0 || begin>=capacity || count<0 || count>capacity)
+        die("DM_GEAR owned row container mismatch piece=%d capacity=%d begin=%d count=%d",piece,capacity,begin,count);
+    memcpy(gear_views[piece].row,owned,0x64);
+    int rarity=gear_get(owned,0x48);
+    if(rarity<0 || rarity>5)die("DM_GEAR invalid owned gear rarity");
+    gear_put(gear_views[piece].row,0x48,rarity<2 ? 2 : rarity);
+    gear_put(gear_views[piece].row,0x4c,gear_wanted[piece][0]);
+    uintptr_t subs=(uintptr_t)gear_views[piece].subs;
+    memcpy(gear_views[piece].row+0x50,&subs,8);
+    gear_put(gear_views[piece].row,0x58,3);gear_put(gear_views[piece].row,0x5c,0);gear_put(gear_views[piece].row,0x60,3);
+    for(int i=0;i<3;i++)gear_views[piece].subs[i]=gear_wanted[piece][i+1];
+    // dm_gate writes x0..x8 back from this saved register block. Redirect x0
+    // only; the underlying owned row and its ring allocation are immutable.
+    ((uint64_t *)(void *)r)[0]=(uintptr_t)gear_views[piece].row;
+}
+static void gear_constructed(const uint64_t *r) {
+    int piece=(int)r[23];if(piece<0 || piece>2)return;
+    void *gear=(void *)(uintptr_t)(piece==0 ? r[22] : piece==1 ? r[28] : r[22]+0x410);
+    int capacity=gear_get(gear,0x90),begin=gear_get(gear,0x94),count=gear_get(gear,0x98);
+    uintptr_t entries;memcpy(&entries,(char *)gear+0x88,8);
+    if(capacity!=3 || !entries || begin<0 || begin>=3 || count<0 || count>3)
+        die("DM_GEAR native subskill container mismatch piece=%d capacity=%d begin=%d count=%d",piece,capacity,begin,count);
+    if(gear_mode==3) {
+        // Retained only to reproduce the pre-fix bisection, explicitly opted
+        // into by diagnostics. Production loadouts use the owned-row adapter.
+        gear_put(gear,0x84,gear_wanted[piece][0]);gear_put(gear,0x80,3);
+        gear_put(gear,0x94,0);gear_put(gear,0x98,3);begin=0;count=3;
+        for(int i=0;i<3;i++)gear_put((void *)entries,0x78*i+0x70,gear_wanted[piece][i+1]);
+    } else if(gear_mode==2) {
+        unsigned char before[0x208];memcpy(before,gear,sizeof before);
+        *(volatile int *)((char *)gear+0x84)=gear_get(gear,0x84);
+        for(int i=0;i<count;i++) {
+            unsigned offset=0x78*((begin+i)%capacity)+0x70;
+            *(volatile int *)(entries+offset)=gear_get((void *)entries,offset);
+        }
+        if(memcmp(before,gear,sizeof before))die("DM_GEAR original writeback changed native kit");
+    }
+    int sub[3]={-1,-1,-1};
+    for(int i=0;i<count;i++)sub[i]=gear_get((void *)entries,0x78*((begin+i)%capacity)+0x70);
+    if(gear_mode==1 && (count!=3 || gear_get(gear,0x84)!=gear_wanted[piece][0] || memcmp(sub,&gear_wanted[piece][1],sizeof sub)))
+        die("DM_GEAR native equipped readback mismatch piece=%d",piece);
+    LOG("SPL3_GEAR piece=%d id=%d main=%d subs=%d,%d,%d count=%d override=%d save_writes=0 backend=%s",
+        piece,gear_get(gear,0x70),gear_get(gear,0x84),sub[0],sub[1],sub[2],count,gear_mode!=0,
+        gear_mode==1 ? "owned_read" : gear_mode==2 ? "original" : gear_mode==3 ? "legacy" : "survey");
+}
+void spl3_gear_install(void) {
+    const char *e=getenv("DM_GEAR");if(!e && !getenv("DM_GEAR_SURVEY"))return;
+    if(strcmp(dm_main_build(),"28c4287aee36f7499da60f3e68b54c70"))die("DM_GEAR requires verified Splatoon 3 11.3.0 main");
+    if(!gate_obs_present(OBS_SPL3_GEAR))die("DM_GEAR requires rewritten local kit gate");
+    if(e && !strcmp(e,"original"))gear_mode=2;
+    else if(e) {
+        const char *legacy=getenv("DM_GEAR_LEGACY");
+        if(legacy && strcmp(legacy,"0") && strcmp(legacy,"1"))die("DM_GEAR_LEGACY must be 0 or 1");
+        gear_mode=legacy && !strcmp(legacy,"1") ? 3 : 1;
+        const char *p=e;
+        for(int i=0;i<12;i++) {
+            errno=0;char *end;long skill=strtol(p,&end,10);
+            if(end==p || errno || skill<(gear_mode==3 ? 0 : 1) || skill>26 || (i%4 && skill>14) || (!(i%4) && ((!skill && gear_mode!=3) || !gear_main_allowed(i/4,(int)skill))) || (*end!=(i==11 ? '\0' : ',')))
+                die("DM_GEAR requires 12 legal native skill indexes; all declared slots must be filled");
+            gear_wanted[i/4][i%4]=(int)skill;p=end+(*end!=0);
+        }
+    }
+    if(gear_mode==1) {
+        if(!gate_obs_present(OBS_SPL3_GEAR_READ))die("DM_GEAR requires rewritten owned gear read gate");
+        gate_obs_set(OBS_SPL3_GEAR_READ,gear_owned_read);
+    }
+    gate_obs_set(OBS_SPL3_GEAR,gear_constructed);
+}
