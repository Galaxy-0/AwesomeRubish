+
+// BSD UDP calls carry only virtual descriptors and opaque datagrams over AF_UNIX.
+static int ldn_skcall(int op,const void *b,size_t n,void *out,size_t cap,size_t *sz) {
+    int err = ldn_rpc(op,b,n,out,cap,sz);
+    // The medium uses BSD-style wire errors, but SDK 22 nn::socket exposes
+    // Linux/newlib errno numbers. main+0x92c490 uses MSG_DONTWAIT and its
+    // error table treats 11 as retry; returning Darwin's 35 aborts the room
+    // with 2318-6635. Keep these namespaces separate from LDN Results.
+    if (err) {
+        switch(err) {
+            case 35: ldn_skerr=11; break;
+            case 42: ldn_skerr=92; break;
+            case 43: ldn_skerr=93; break;
+            case 45: ldn_skerr=95; break;
+            case 48: ldn_skerr=98; break;
+            case 49: ldn_skerr=99; break;
+            case 50: ldn_skerr=100; break;
+            case 51: ldn_skerr=101; break;
+            default: ldn_skerr=err; break;
+        } static _Atomic unsigned failures[32]; if(op<32){unsigned k=atomic_fetch_add(&failures[op],1)+1;if((k&(k-1))==0)LOG("LDN socket op=%d errno=%d count=%u state=%d",op,err,k,atomic_load(&g_ldn_state));} return -1; } return 0;
+}
+int dm_ldn_socket(int f,int t,int p) { uint32_t b[]={f,t,p},fd=0; return ldn_skcall(20,b,sizeof b,&fd,4,NULL) ? -1 : (int)fd; }
+int dm_ldn_bind(int fd,const void *a,unsigned n) { if (!a || n < 16) { ldn_skerr=22; return -1; } uint8_t b[20]; memcpy(b,&fd,4); memcpy(b+4,a,16); return ldn_skcall(21,b,20,NULL,0,NULL); }
+long dm_ldn_sendto(int fd,const void *buf,size_t n,int flags,const void *a,unsigned len) {
+    (void)flags;
+    if (!a || len < 16 || n > 65507 || (!buf && n)) { ldn_skerr=22; return -1; }
+    uint8_t *b=malloc(n+20); if (!b) { ldn_skerr=12; return -1; }
+    memcpy(b,&fd,4); memcpy(b+4,a,16); if(n) memcpy(b+20,buf,n);
+    uint32_t sent=0; int r=ldn_skcall(22,b,n+20,&sent,4,NULL); free(b); return r ? -1 : (long)sent;
+}
+long dm_ldn_recvfrom(int fd,void *buf,size_t n,int flags,void *a,unsigned *len) {
+    (void)flags;
+    if ((!buf && n) || (a && !len)) { ldn_skerr=22; return -1; }
+    uint8_t *b=malloc(LDN_LIMIT); if (!b) { ldn_skerr=12; return -1; } size_t sz=0;
+    int r=ldn_skcall(23,&fd,4,b,LDN_LIMIT,&sz);
+    if (!r && sz >= 16) { if (n > sz-16) n=sz-16; if(n) memcpy(buf,b+16,n); if(a) { unsigned k=*len<16?*len:16; memcpy(a,b,k); *len=16; } }
+    else { n=0; if (!r) { r=-1; ldn_skerr=22; } }
+    free(b); return r ? -1 : (long)n;
+}
+int dm_ldn_poll(void *fds,size_t n,int timeout) {
+    if (n > 64 || (!fds && n) || timeout < -1) { ldn_skerr=22; return -1; }
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); uint64_t start=(uint64_t)t.tv_sec*1000+t.tv_nsec/1000000;
+    uint8_t b[512];
+    for (;;) {
+        if (ldn_skcall(25,fds,n*8,b,sizeof b,NULL)) return -1;
+        int ready=0; for (size_t i=0;i<n;i++) if (((int16_t *)(b+i*8))[3]) ready++;
+        clock_gettime(CLOCK_MONOTONIC,&t); uint64_t now=(uint64_t)t.tv_sec*1000+t.tv_nsec/1000000;
+        if (ready || (timeout >= 0 && now-start >= (unsigned)timeout)) { memcpy(fds,b,n*8); return ready; }
+        usleep(2000);
+    }
+}
+int dm_ldn_close(int fd) { return ldn_skcall(24,&fd,4,NULL,0,NULL); }
+int dm_ldn_sockname(int fd,void *a,unsigned *n) { if(!a||!n) { ldn_skerr=22; return -1; } uint8_t b[16]; int r=ldn_skcall(26,&fd,4,b,16,NULL); if(!r){ unsigned k=*n<16?*n:16; memcpy(a,b,k); *n=16; } return r; }
+int dm_ldn_sockopt(int fd,int level,int option,const void *v,unsigned n) {
+    // FreeBSD SOL_SOCKET: REUSEADDR/REUSEPORT/BROADCAST/SNDBUF/RCVBUF, IP_TOS.
+    LOG("LDN SetSockOpt fd=%d level=%#x option=%#x len=%u",fd,level,option,n);
+    if (!v || n != 4 || !((level == 0xffff && (option == 4 || option == 0x20 || option == 0x200 || option == 0x1001 || option == 0x1002)) || (level == 0 && option == 3))) { ldn_skerr=92; return -1; }
+    uint32_t b[4]={(uint32_t)fd,(uint32_t)level,(uint32_t)option,ld32(v)};
+    return ldn_skcall(30,b,sizeof b,NULL,0,NULL);
+}
+int dm_ldn_eventfd(uint64_t value,int flags) { uint8_t b[12]; memcpy(b,&value,8); memcpy(b+8,&flags,4); uint32_t fd=0; return ldn_skcall(27,b,12,&fd,4,NULL) ? -1 : (int)fd; }
+int dm_ldn_eventread(int fd,uint64_t *value) { if(!value){ldn_skerr=22;return -1;} return ldn_skcall(28,&fd,4,value,8,NULL); }
+int dm_ldn_eventwrite(int fd,uint64_t value) { uint8_t b[12];memcpy(b,&fd,4);memcpy(b+4,&value,8);return ldn_skcall(29,b,12,NULL,0,NULL); }
