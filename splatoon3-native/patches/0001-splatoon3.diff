diff --git a/dm/gfx/nvn/nvn_pipeline_cache.inc b/dm/gfx/nvn/nvn_pipeline_cache.inc
new file mode 100644
index 0000000..3585f92
--- /dev/null
+++ b/dm/gfx/nvn/nvn_pipeline_cache.inc
@@ -0,0 +1,78 @@
+// Device-built GPU binaries. Cache entries are immutable after atomic rename;
+// an advisory per-key lock prevents simultaneous compilation by local hosts.
+// MTLLibrary source-to-IR still uses Metal's system cache: no public library
+// serialization API is assumed here. Archives cache the GPU pipeline binaries.
+static _Atomic uint64_t g_disk_hit, g_disk_miss, g_disk_write, g_disk_error;
+static NSString *pipeline_disk_path(NSData *key, NSArray<NSString *> *shaders) {
+    const char *root = getenv("DM_PIPELINE_CACHE");
+    if (!root || !*root) return nil;
+    NSMutableData *data = [NSMutableData dataWithData:key];
+    NSString *version = [NSString stringWithFormat:@"cache-v1:%s:%llu:%@", DMSH_CHAIN,
+        (unsigned long long)g_dev.registryID, NSProcessInfo.processInfo.operatingSystemVersionString];
+    [data appendData:[version dataUsingEncoding:NSUTF8StringEncoding]];
+    for (NSString *sh in shaders) {
+        NSData *source = [NSData dataWithContentsOfFile:[NSString stringWithFormat:@"%@/%@.metallib", g_msl_dir, sh]];
+        if (!source) return nil;
+        [data appendData:source];
+    }
+    unsigned char hash[CC_SHA256_DIGEST_LENGTH]; CC_SHA256(data.bytes, (CC_LONG)data.length, hash);
+    char hex[65]; for (int i=0; i<32; i++) snprintf(hex+i*2,3,"%02x",hash[i]);
+    NSString *dir = [@(root) stringByAppendingPathComponent:[[NSString stringWithUTF8String:hex] substringToIndex:2]];
+    if (![NSFileManager.defaultManager createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil]) return nil;
+    return [dir stringByAppendingPathComponent:[NSString stringWithFormat:@"%s.metalar",hex]];
+}
+static id pipeline_disk_build_body(id descriptor, NSData *key, NSArray<NSString *> *shaders, int compute, NSError **error) {
+    NSString *path = pipeline_disk_path(key,shaders);
+    if (!path) return compute ? (id)[g_dev newComputePipelineStateWithDescriptor:descriptor options:0 reflection:nil error:error]
+                              : (id)[g_dev newRenderPipelineStateWithDescriptor:descriptor error:error];
+    int fd = open([[path stringByAppendingString:@".lock"] fileSystemRepresentation],O_CREAT|O_RDWR,0600);
+    if (fd < 0 || flock(fd,LOCK_EX)) { if(fd>=0)close(fd); atomic_fetch_add(&g_disk_error,1);
+        return compute ? (id)[g_dev newComputePipelineStateWithDescriptor:descriptor options:0 reflection:nil error:error]
+                       : (id)[g_dev newRenderPipelineStateWithDescriptor:descriptor error:error]; }
+    NSError *e=nil; MTLBinaryArchiveDescriptor *ad=[MTLBinaryArchiveDescriptor new];
+    if ([NSFileManager.defaultManager fileExistsAtPath:path]) ad.url=[NSURL fileURLWithPath:path];
+    id<MTLBinaryArchive> archive=[g_dev newBinaryArchiveWithDescriptor:ad error:&e];
+    id pipeline=nil;
+    if (archive && ad.url) {
+        [descriptor setBinaryArchives:@[archive]];
+        pipeline=compute ? (id)[g_dev newComputePipelineStateWithDescriptor:descriptor options:MTLPipelineOptionFailOnBinaryArchiveMiss reflection:nil error:&e]
+                         : (id)[g_dev newRenderPipelineStateWithDescriptor:descriptor options:MTLPipelineOptionFailOnBinaryArchiveMiss reflection:nil error:&e];
+    }
+    if(pipeline) atomic_fetch_add(&g_disk_hit,1);
+    else {
+        atomic_fetch_add(&g_disk_miss,1);
+        ad.url=nil; archive=[g_dev newBinaryArchiveWithDescriptor:ad error:&e];
+        [descriptor setBinaryArchives:nil];
+        BOOL added=archive && (compute ? [archive addComputePipelineFunctionsWithDescriptor:descriptor error:&e]
+                                       : [archive addRenderPipelineFunctionsWithDescriptor:descriptor error:&e]);
+        if(added) [descriptor setBinaryArchives:@[archive]];
+        pipeline=compute ? (id)[g_dev newComputePipelineStateWithDescriptor:descriptor options:0 reflection:nil error:error]
+                         : (id)[g_dev newRenderPipelineStateWithDescriptor:descriptor error:error];
+        if(pipeline && added) {
+            NSString *tmp=[path stringByAppendingFormat:@".%d.tmp",getpid()];
+            if([archive serializeToURL:[NSURL fileURLWithPath:tmp] error:&e] && !rename(tmp.fileSystemRepresentation,path.fileSystemRepresentation)) atomic_fetch_add(&g_disk_write,1);
+            else { atomic_fetch_add(&g_disk_error,1); unlink(tmp.fileSystemRepresentation); }
+        } else atomic_fetch_add(&g_disk_error,1);
+    }
+    [descriptor setBinaryArchives:nil]; flock(fd,LOCK_UN);close(fd);
+    uint64_t hits=atomic_load(&g_disk_hit), misses=atomic_load(&g_disk_miss);
+    if((hits+misses)%100==1) MLOG("PIPELINE_DISK hit=%llu miss=%llu write=%llu error=%llu",(unsigned long long)hits,(unsigned long long)misses,(unsigned long long)atomic_load(&g_disk_write),(unsigned long long)atomic_load(&g_disk_error));
+    return pipeline;
+}
+static id pipeline_disk_build(id descriptor, NSData *key, NSArray<NSString *> *shaders, int compute, NSError **error) {
+    // NSError** is autoreleasing under ARC. Own it outside the inner pool
+    // before publishing it into the caller's writeback temporary.
+    NSError *failure=nil; id result;
+    @autoreleasepool { result=pipeline_disk_build_body(descriptor,key,shaders,compute,&failure); }
+    if(error) *error=failure;
+    return result;
+}
+static id<MTLRenderPipelineState> render_cached(MTLRenderPipelineDescriptor *d, const pso_skey *key, NSError **e) {
+    NSMutableArray *shaders=[NSMutableArray array];
+    if(key->vs[0]) [shaders addObject:@(key->vs)]; if(key->fs[0]) [shaders addObject:@(key->fs)];
+    return pipeline_disk_build(d,[NSData dataWithBytes:key length:sizeof *key],shaders,0,e);
+}
+static id<MTLComputePipelineState> compute_cached(NvShader *cs, NSError **e) {
+    MTLComputePipelineDescriptor *d=[MTLComputePipelineDescriptor new]; d.computeFunction=cs->fn;
+    return pipeline_disk_build(d,[@(cs->key) dataUsingEncoding:NSUTF8StringEncoding],@[@(cs->key)],1,e);
+}
