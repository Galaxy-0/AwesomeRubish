+        code[2] = 0xd65f03c0;
+        mprotect(code,0x4000,PROT_READ|PROT_EXEC);sys_icache_invalidate(code,12);
+        register void *param __asm__("x23") = saved; register unsigned actual __asm__("w0");
+        __asm__ volatile("blr %2" : "=r"(actual) : "r"(param), "r"(code) : "x1","x8","x16","x17","x30","cc","memory");
+        failed += actual != wanted; munmap(code,0x4000);
+    }
+    failed += saved[0x194/4] != 2040;
+    printf("spl3-weapon: 3 checks, %d failed\n",failed);return failed != 0;
+}
