diff --git a/dm/host/tests/t_spl3_unlock.c b/dm/host/tests/t_spl3_unlock.c
new file mode 100644
index 0000000..8f41733
--- /dev/null
+++ b/dm/host/tests/t_spl3_unlock.c
@@ -0,0 +1,97 @@
+// Synthetic executable memory exercises opt-in/build/signature guards, no game image.
+#include "../hle_spl3_unlock.c"
+module_t g_mod[MAX_MOD]; int g_nmod;
+static int checks, failures;
+#define CHECK(label, condition) do { checks++; if (!(condition)) { failures++; fprintf(stderr, "FAIL %s\n", label); } } while (0)
+int main(int argc, char **argv) {
+    g_nmod = 1; module_t *m = &g_mod[0]; strcpy(m->name, "main");
+    strcpy(m->build_id, argc > 1 && !strcmp(argv[1], "unknown") ? "unknown" : "28c4287aee36f7499da60f3e68b54c70");
+    m->text_end = m->size = 0x4404000;
+    m->base = mmap(NULL, m->size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (m->base == MAP_FAILED) return 2;
+    for (unsigned i = 0; i < sizeof ownership_cuts / sizeof *ownership_cuts; i++)
+        *(uint32_t *)(m->base + ownership_cuts[i].offset) = ownership_cuts[i].expected;
+    if (argc > 1 && !strcmp(argv[1], "mismatch")) *(uint32_t *)(m->base + ownership_cuts[2].offset) = 0;
+    // Original predicate prefix: ldr ID; tbnz invalid -> false return.
+    *(uint32_t *)(m->base + 0x338bbe0) = 0xb9400428;
+    *(uint32_t *)(m->base + 0x338bbe4) = 0x37f81b48;
+    *(uint32_t *)(m->base + 0x338bf4c) = 0x2a1f03e0;
+    *(uint32_t *)(m->base + 0x338bf50) = 0xd65f03c0;
+    // Type guard exits become tiny stand-ins for native accept/skip loop arms.
+    *(uint32_t *)(m->base + 0x4401d74) = 0x52800000; // mov w0,0
+    *(uint32_t *)(m->base + 0x4401d78) = 0xd65f03c0;
+    *(uint32_t *)(m->base + 0x4401e4c) = 0x52800020; // mov w0,1
+    *(uint32_t *)(m->base + 0x4401e50) = 0xd65f03c0;
+    // Native private-stage display flag and season guard, with accept/skip stubs.
+    *(uint32_t *)(m->base + 0x39049e4) = 0x39407008;
+    *(uint32_t *)(m->base + 0x39049e8) = 0x340003a8;
+    *(uint32_t *)(m->base + 0x39049ec) = 0xb9401808;
+    *(uint32_t *)(m->base + 0x39049f0) = 0x6b16011f;
+    *(uint32_t *)(m->base + 0x39049f8) = 0x52800020;
+    *(uint32_t *)(m->base + 0x39049fc) = 0xd65f03c0;
+    *(uint32_t *)(m->base + 0x3904a5c) = 0x52800000;
+    *(uint32_t *)(m->base + 0x3904a60) = 0xd65f03c0;
+    // The picker has an independent native flag / season filter.
+    *(uint32_t *)(m->base + 0x31f52c8) = 0x394072a8;
+    *(uint32_t *)(m->base + 0x31f52cc) = 0x34000f88;
+    *(uint32_t *)(m->base + 0x31f52d0) = 0xb9401aa8;
+    *(uint32_t *)(m->base + 0x31f52d4) = 0x6b17011f;
+    *(uint32_t *)(m->base + 0x31f52dc) = 0x52800020;
+    *(uint32_t *)(m->base + 0x31f52e0) = 0xd65f03c0;
+    *(uint32_t *)(m->base + 0x31f54bc) = 0x52800000;
+    *(uint32_t *)(m->base + 0x31f54c0) = 0xd65f03c0;
+    if (mprotect(m->base, m->size, PROT_READ | PROT_EXEC)) return 2;
+    spl3_unlock_install();
+    int enabled = getenv("DM_FULL_UNLOCK") && !strcmp(getenv("DM_FULL_UNLOCK"), "1");
+    for (unsigned i = 0; i < sizeof ownership_cuts / sizeof *ownership_cuts; i++) {
+        const spl3_cut *c = &ownership_cuts[i];
+        CHECK(c->reason, *(uint32_t *)(m->base + c->offset) == (enabled ? c->replacement : c->expected));
+    }
+    for (unsigned display = 0; display < 2; display++) {
+        for (int season = -1; season <= 8; season++) {
+            unsigned char stage[0x20] = {0};
+            *(int *)(stage + 0x18) = season;
+            stage[0x1c] = display;
+            register uintptr_t row __asm__("x0") = (uintptr_t)stage;
+            register uintptr_t ceiling __asm__("x22") = 4;
+            void *guard = m->base + 0x39049e4;
+            __asm__ volatile("blr %2" : "+r"(row) : "r"(ceiling), "r"(guard) : "x8", "x30", "cc", "memory");
+            CHECK("private stages retain hidden flag; season override is opt-in",
+                  row == (display && (enabled || season <= 4)));
+            register uintptr_t picker_stage __asm__("x21") = (uintptr_t)stage;
+            register uintptr_t picker_ceiling __asm__("x23") = 4;
+            register uintptr_t accepted __asm__("x0");
+            guard = m->base + 0x31f52c8;
+            __asm__ volatile("blr %3" : "=r"(accepted) : "r"(picker_stage), "r"(picker_ceiling), "r"(guard) : "x8", "x30", "cc", "memory");
+            CHECK("stage picker retains hidden flag; season override is opt-in",
+                  accepted == (display && (enabled || season <= 4)));
+
+        }
+    }
+    if (enabled) {
+        int item[2] = {1, 100};
+        unsigned (*owned)(void *, int *) = (void *)(m->base + 0x338bbe0);
+        CHECK("valid weapon returns owned without touching save", owned(NULL, item) == 1);
+        item[1] = -1;
+        CHECK("negative sentinel stays invalid", owned(NULL, item) == 0);
+        unsigned char metadata[0x60] = {0};
+        uintptr_t wrapper[2] = {0, (uintptr_t)metadata};
+        for (unsigned type = 0; type < 5; type++) {
+            *(unsigned *)(metadata + 0x50) = type;
+            register uintptr_t row __asm__("x0") = (uintptr_t)wrapper;
+            register uintptr_t category __asm__("x20") = 0;
+            void *guard = m->base + 0x4401f18;
+            __asm__ volatile("blr %2" : "+r"(row) : "r"(category), "r"(guard) : "x8", "x30", "cc", "memory");
+            CHECK("selector admits only Versus metadata", row == (type == 0));
+        }
+        wrapper[1] = 0; // gear must bypass weapon metadata access
+        register uintptr_t row __asm__("x0") = (uintptr_t)wrapper;
+        register uintptr_t category __asm__("x20") = 1;
+        void *guard = m->base + 0x4401f18;
+        __asm__ volatile("blr %2" : "+r"(row) : "r"(category), "r"(guard) : "x8", "x30", "cc", "memory");
+        CHECK("gear categories bypass weapon type guard", row == 1);
+    }
+    munmap(m->base, m->size);
+    printf("spl3-unlock: %d checks, %d failed\n", checks, failures);
+    return failures != 0;
+}
