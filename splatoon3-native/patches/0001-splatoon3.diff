@@ -0,0 +1,29 @@
+// Production guest SleepThread + timed event waits under slow/pause stepping.
+#include "../dm.h"
+#include <stdatomic.h>
+#include <unistd.h>
+extern int test_fixed60;
+extern _Atomic uint64_t test_guest_advance;
+int svc_thread(int num,uint64_t *regs);
+uint32_t svc_thread_main_init(void);
+void (*dm_test_cv_after_release)(void);
+static void *advance(void *arg) {
+    unsigned count=(unsigned)(uintptr_t)arg;
+    for(unsigned n=1;n<=count;n++) {
+        if(n==15)usleep(350000); // Strategy pause: guest time is held.
+        usleep(200000);atomic_fetch_add(&test_guest_advance,UINT64_C(1000000000)/60+1);
+    }
+    return NULL;
+}
+int main(void) {
+    alarm(110);svc_thread_main_init();test_fixed60=1;pthread_t driver;
+    pthread_create(&driver,NULL,advance,(void *)(uintptr_t)326);
+    uint64_t regs[32]={5425000000};uint64_t before=now_ns();svc_thread(0x0B,regs);pthread_join(driver,NULL);
+    if(now_ns()-before<UINT64_C(60000000000) || atomic_load(&test_guest_advance)<5425000000)return 1;
+    uint64_t event[32]={0};svc_thread(0x45,event);uint32_t read_handle=(uint32_t)event[2];
+    pthread_create(&driver,NULL,advance,(void *)(uintptr_t)65);
+    uint64_t wait[32]={0};wait[1]=(uintptr_t)&read_handle;wait[2]=1;wait[3]=1000000000;
+    svc_thread(0x18,wait);pthread_join(driver,NULL);
+    if(wait[0]!=0xEA01u)return 1;
+    puts("rl-long-wait: production 5.425s guest sleep and timed event survived slow steps/pause");return 0;
+}
