diff --git a/dm/host/tests/t_account_player.c b/dm/host/tests/t_account_player.c
new file mode 100644
index 0000000..7a3d75c
--- /dev/null
+++ b/dm/host/tests/t_account_player.c
@@ -0,0 +1,30 @@
+// Account APIs agree on the process-local identity; each invocation is fresh.
+#include "../hle_account.c"
+module_t g_mod[MAX_MOD]; int g_nmod;
+void hle_signal_system_event(void *ev) { (void)ev; }
+static int checks, failures;
+#define CHECK(label, condition) do { checks++; if (!(condition)) { failures++; fprintf(stderr, "FAIL %s\n", label); } } while (0)
+int main(int argc, char **argv) {
+    g_nmod = 1; strcpy(g_mod[0].name, "main");
+    strcpy(g_mod[0].build_id, argc > 1 ? "unknown" : "28c4287aee36f7499da60f3e68b54c70"); (void)argv;
+    h_acc_Init();
+    const char *e = getenv("DM_PLAYER"); int p = e ? atoi(e) : 0;
+    Uid want = k_uid; want.v[0] += p;
+    Uid u = {0}; UserHandle h;
+    int n = 0; uint8_t exists = 0;
+    CHECK("preselected handle opens", h_acc_TryOpenPre(&h) == 1);
+    CHECK("handle returns expected UID", h_acc_GetUserId(&u, &h) == RES_OK && !memcmp(&u, &want, sizeof u));
+    CHECK("open-user list agrees", h_acc_ListOpen(&n, &u, 1) == RES_OK && n == 1 && !memcmp(&u, &want, sizeof u));
+    CHECK("all-user list agrees", h_acc_ListAll(&n, &u, 1) == RES_OK && n == 1 && !memcmp(&u, &want, sizeof u));
+    CHECK("qualified-user list agrees", h_acc_ListQual(&n, &u, 1) == RES_OK && n == 1 && !memcmp(&u, &want, sizeof u));
+    CHECK("user selector agrees", h_acc_ShowSel(&u, NULL) == RES_OK && !memcmp(&u, &want, sizeof u));
+    CHECK("local UID exists", h_acc_Exists(&exists, &want) == RES_OK && exists);
+    Uid foreign = want; foreign.v[0] += 99;
+    CHECK("other process UID does not exist locally", h_acc_Exists(&exists, &foreign) == RES_OK && !exists);
+    char nick[33], expected[33];
+    if (e) snprintf(expected, sizeof expected, "RL-%d", p);
+    else snprintf(expected, sizeof expected, "%s", getenv("DM_NICK") ? getenv("DM_NICK") : "Player");
+    CHECK("nickname matches player", h_acc_GetNick(nick, &want) == RES_OK && !strcmp(nick, expected));
+    printf("account-player: %d checks, %d failed uid=%016llx:%016llx nickname=%s\n", checks, failures, u.v[0], u.v[1], nick);
+    return failures != 0;
+}
