diff --git a/dm/host/hle_rl.c b/dm/host/hle_rl.c
new file mode 100644
index 0000000..9f35711
--- /dev/null
+++ b/dm/host/hle_rl.c
@@ -0,0 +1,472 @@
+// Frame-boundary controller and cropped internal pixels over a POSIX Unix socket.
+// The game consumes input on its own thread. The IPC thread never advances it.
+#include "hle.h"
+#include "dm_rl.h"
+#include "dm_rl_clock.h"
+#include "dm_rl_watchdog.h"
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <math.h>
+#include <stdatomic.h>
+#include <stdarg.h>
+#ifdef SPL3_A6_TEST_SPECIAL
+#include "dm_spl3_test_special.h"
+#endif
+
+static int rl_listener = -1, rl_peer = -1;
+static _Atomic int rl_enabled, rl_controlled, rl_remaining, rl_phase;
+static _Atomic uint64_t rl_last_input = UINT64_MAX, rl_frame;
+static uint64_t rl_request, rl_step_start, rl_without_input, rl_budget_end, rl_input_floor;
+static _Atomic uint64_t rl_input_repeats;
+static pthread_mutex_t rl_input_mu = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t rl_input_cv = PTHREAD_COND_INITIALIZER;
+static _Atomic uint64_t rl_input_seen[4096];
+static dm_rl_action_t rl_pending, rl_latched;
+static pthread_mutex_t rl_pixels_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t rl_image[DM_RL_BYTES];
+static uint64_t rl_image_frame;
+static unsigned rl_source_width, rl_source_height;
+static int rl_have_image;
+static dm_rl_clock *rl_clock;
+static int rl_fixed_clock;
+static pthread_mutex_t rl_state_mu = PTHREAD_MUTEX_INITIALIZER;
+static float rl_position[3], rl_ink, rl_heading, rl_hp, rl_special;
+static float rl_view_yaw, rl_view_pitch;
+static int rl_view_seen;
+static uint64_t rl_position_frame, rl_state_sequence;
+static int rl_position_seen, rl_ink_seen, rl_heading_seen, rl_hp_seen, rl_special_seen, rl_state_dump;
+static int rl_form_squid=-1,rl_ground_contact=-1;
+static float rl_time;static int rl_time_seen;static uint64_t rl_time_frame;
+static int rl_self_slot=-1,rl_self_seen,rl_self_ambiguous,rl_self_health=-1;
+static uintptr_t rl_hud_node[8];
+static int rl_hud_status[8],rl_hud_seen[8],rl_hud_ever[8],rl_hud_special[8];
+static uint64_t rl_hud_frame[8],rl_hud_touch[8],rl_hud_downs[8];
+static float rl_score[2],rl_turf[2];static int rl_score_seen,rl_score_units;static uint64_t rl_score_frame;
+
+static uint64_t rl_stall_limit_ns=UINT64_C(120000000000);
+static void *rl_watchdog_main(void *unused) {
+    (void)unused;dm_rl_watchdog watch={0};
+    for (;;) {
+        int paused=rl_clock && (atomic_load(&rl_clock->state)&DM_RL_CLOCK_PAUSED);
+        int running=atomic_load(&rl_controlled) && atomic_load(&rl_remaining)>0 && !paused;
+        uint64_t frame=atomic_load(&rl_frame);
+        if(dm_rl_watchdog_poll(&watch,dm_rl_clock_wall(),frame,running,rl_stall_limit_ns))
+            die("RL_STALL no present progress frame=%llu active_stall_ns=%llu limit_ns=%llu remaining=%d",frame,watch.stalled,rl_stall_limit_ns,atomic_load(&rl_remaining));
+        struct timespec poll={0,50000000};nanosleep(&poll,NULL);
+    }
+    return NULL;
+}
+
+int dm_rl_active(void) { return atomic_load(&rl_controlled); }
+int dm_rl_match_phase(void) { return atomic_load(&rl_phase); }
+int dm_rl_frame_allowed(uint64_t frame) {
+    if (!dm_rl_active()) return 1;
+    pthread_mutex_lock(&rl_input_mu);
+    int allowed=frame<rl_budget_end;
+    pthread_mutex_unlock(&rl_input_mu);
+    return allowed;
+}
+int dm_rl_capture_needed(void) {
+    return atomic_load(&rl_enabled) && (!dm_rl_active() || atomic_load(&rl_remaining) <= 1);
+}
+void dm_rl_pixels(const uint8_t *rgb, uint64_t frame, unsigned width, unsigned height) {
+    pthread_mutex_lock(&rl_pixels_mu);
+    memcpy(rl_image, rgb, sizeof rl_image);
+    rl_image_frame = frame; rl_source_width = width; rl_source_height = height; rl_have_image = 1;
+    pthread_mutex_unlock(&rl_pixels_mu);
+}
+static void phase_ingame(const uint64_t *r) {
+    (void)r;
+#ifdef SPL3_A6_TEST_SPECIAL
+    a6_special_reset();
+#endif
+    pthread_mutex_lock(&rl_state_mu); rl_position_seen = rl_ink_seen = rl_heading_seen = rl_hp_seen = rl_special_seen = rl_time_seen = rl_score_seen = rl_view_seen = 0;
+    rl_self_slot=-1;rl_self_seen=rl_self_ambiguous=0;rl_self_health=-1;
+    rl_form_squid=rl_ground_contact=-1;
+    for(int i=0;i<8;i++){rl_hud_node[i]=0;rl_hud_status[i]=2;rl_hud_seen[i]=rl_hud_ever[i]=rl_hud_special[i]=0;rl_hud_frame[i]=rl_hud_touch[i]=rl_hud_downs[i]=0;}
+    pthread_mutex_unlock(&rl_state_mu);
+    atomic_store(&rl_phase, 1);
+}
+static void phase_judge(const uint64_t *r) {
+    (void)r; atomic_store(&rl_phase, 2);
+    // Already latched input stays immutable through this present interval.
+    // Every new frame after settlement latches neutral instead.
+}
+static void phase_winners(const uint64_t *r) { (void)r; atomic_store(&rl_phase, 3); }
+static void local_state(const uint64_t *r) {
+    if (atomic_load(&rl_phase) != 1) return;
+    // PlayerNetState's encoder reads three signed absolute coordinates here,
+    // before velocity/direction codecs. In the verified 2-peer counterexample
+    // only this process's actions move this encoder's source; remote-only
+    // movement leaves it stationary. Copy during the live call, no saved ptr.
+    const uint8_t *source = (const uint8_t *)(uintptr_t)r[0];
+    float position[3], ink, facing[3]; memcpy(position, source+0x20, sizeof position);
+    // Own body forward unit vector, not camera yaw (the latter is at +0x5c).
+    memcpy(facing,source+0x44,sizeof facing);
+    float norm=facing[0]*facing[0]+facing[1]*facing[1]+facing[2]*facing[2];
+    int heading_valid=isfinite(norm) && fabsf(norm-1)<.01f && facing[0]*facing[0]+facing[2]*facing[2]>.0001f;
+    // Normalized ink: verified with separate own/peer fire and recovery windows.
+    memcpy(&ink,source+0x84,sizeof ink);
+    // Verified against the live PlayerDamage update through hits and recovery.
+    uint32_t health,special;memcpy(&health,source+0x70,sizeof health);
+    // Integer percent; matched against the local special HUD (75 display units).
+    memcpy(&special,source+0x80,sizeof special);
+    int valid = 1;
+    for (int i=0;i<3;i++) if (!isfinite(position[i]) || fabsf(position[i]) > 256) valid = 0;
+    uint64_t frame = dm_guest_frame();
+    pthread_mutex_lock(&rl_state_mu);
+    memcpy(rl_position,position,sizeof position);rl_position_frame=frame;rl_position_seen=valid;
+    rl_ink=ink;rl_ink_seen=isfinite(ink) && ink>=0 && ink<=1;
+    rl_special_seen=special<=100;rl_special=rl_special_seen ? special/100.0f : 0;
+    rl_hp_seen=health<=1000;rl_hp=rl_hp_seen ? health/1000.0f : 0;
+    rl_heading_seen=heading_valid;rl_heading=heading_valid ? atan2f(facing[0],facing[2]) : 0;
+    // A4 own control feedback, already calibrated by M6 packet diagnostics.
+    // This is not the abandoned game-camera visibility probe. Only this
+    // process's own view may enter its own allowlisted policy record.
+    float view[3],pitch;memcpy(view,source+0x5c,sizeof view);memcpy(&pitch,source+0x68,4);
+    float view_norm=view[0]*view[0]+view[2]*view[2];
+    rl_view_seen=isfinite(view_norm) && fabsf(view_norm-1)<.01f && isfinite(pitch) && fabsf(pitch)<=1;
+    rl_view_yaw=rl_view_seen ? atan2f(view[0],view[2]) : 0;rl_view_pitch=rl_view_seen ? pitch : 0;
+    // A3 approximation: diagnosed on both native sides, outside ink / own ink /
+    // airborne. This is form + contact, not a claim that all squid are hidden.
+    uint32_t form,contact;memcpy(&form,source+0xf8,4);memcpy(&contact,source+0x94,4);
+    rl_form_squid=form<=1 ? form==0 : -1;
+    rl_ground_contact=(contact==0 || contact==4 || contact==5) ? (int)contact : -1;
+    uint64_t sequence=++rl_state_sequence;
+    pthread_mutex_unlock(&rl_state_mu);
+    // Development-only raw scalar survey. Game data stays in the run's log;
+    // these bytes are never exposed as named training fields without a test.
+    if (rl_state_dump) {
+        char hex[0x1f0*2+1]; static const char digits[]="0123456789abcdef";
+        for (unsigned i=0;i<0x1f0;i++) { hex[i*2]=digits[source[i]>>4];hex[i*2+1]=digits[source[i]&15]; }
+        hex[sizeof hex-1]=0;
+        LOG("RL_STATE frame=%llu sequence=%llu data=%s",frame,sequence,hex);
+    }
+}
+
+static void timer_state(const uint64_t *r) {
+    if (atomic_load(&rl_phase)!=1) return;
+    // SplUITimerCtrl's live update consumes a countdown in native 1/60 s units.
+    // Ready-room HUDs finish before InGame; never retain/dereference the object.
+    const uint8_t *source=(const uint8_t *)(uintptr_t)r[0];
+    float raw;int scale;memcpy(&raw,source+0x140,4);memcpy(&scale,source+0x14c,4);
+    int valid=source[0x148] && scale==60 && isfinite(raw) && raw>=0 && raw<=36000;
+    pthread_mutex_lock(&rl_state_mu);
+    rl_time_seen=valid;rl_time=valid ? raw/60.0f : 0;rl_time_frame=dm_guest_frame();
+    pthread_mutex_unlock(&rl_state_mu);
+}
+
+static void score_state(const uint64_t *r,int units) {
+    int phase=atomic_load(&rl_phase);if (phase<2) return;
+    if(!(r[1]|r[2]|r[3]|r[4]))return; // Native reset formatter, not a result.
+    uint32_t a=(uint32_t)r[3],b=(uint32_t)r[4];
+    if (a>(units==1?1000:100) || b>(units==1?1000:100)) return;
+    // The actual text formatter divides PaintPercent by ten. Its operands
+    // are already observer-relative; the bar's raw areas are different args.
+    pthread_mutex_lock(&rl_state_mu);
+    if(phase>=3 && rl_score_seen){pthread_mutex_unlock(&rl_state_mu);return;}
+    rl_score[0]=units==1 ? a/10.0f : a;rl_score[1]=units==1 ? b/10.0f : b;
+    rl_turf[0]=units==1 ? a/1000.0f : 0;rl_turf[1]=units==1 ? b/1000.0f : 0;
+    rl_score_units=units;rl_score_seen=1;rl_score_frame=dm_guest_frame();
+    pthread_mutex_unlock(&rl_state_mu);
+}
+static void turf_score(const uint64_t *r) {score_state(r,1);}
+static void rule_score(const uint64_t *r) {score_state(r,2);}
+
+// Only called while the native caller holds a live Player reference. The same
+// PlayerInfo slot load is used by this build's native player/network code.
+static int player_slot(uintptr_t player) {
+    uintptr_t storage=0,info=0;int slot=-1;
+    if(!player)return -1;memcpy(&storage,(void *)(player+0x108),8);
+    if(!storage)return -1;memcpy(&info,(void *)(storage+8),8);
+    if(!info)return -1;memcpy(&slot,(void *)(info+0x7e8),4);
+    return slot>=0 && slot<8 ? slot : -1;
+}
+static void own_player(const uint64_t *r) {
+    if(atomic_load(&rl_phase)!=1)return;
+    uintptr_t player=0;memcpy(&player,(const void *)(uintptr_t)(r[0]+0xf00),8);
+    int slot=player_slot(player);if(slot<0)return;
+    pthread_mutex_lock(&rl_state_mu);
+    int health;memcpy(&health,(const void *)(uintptr_t)(r[0]+0x88),4);
+    int health_changed=rl_self_health!=health;rl_self_health=health;
+    int first=!rl_self_seen;
+    if(rl_self_seen && rl_self_slot!=slot)rl_self_ambiguous=1;
+    rl_self_slot=slot;rl_self_seen=1;
+    pthread_mutex_unlock(&rl_state_mu);
+#ifdef SPL3_A6_TEST_SPECIAL
+    a6_special_update(player,slot,health);
+#endif
+    if(first)LOG("RL_SELF_SLOT slot=%d player=%p",slot,(void *)player);
+    if(health_changed && rl_state_dump)LOG("RL_DAMAGE frame=%llu slot=%d hp=%d",dm_guest_frame(),slot,health);
+}
+static void hud_bind(const uint64_t *r) {
+    if(atomic_load(&rl_phase)!=1)return;
+    // Native RTTI has just confirmed x20 is Player, with its weak ref held.
+    int slot=player_slot((uintptr_t)r[20]);if(slot<0)return;
+    uintptr_t node=(uintptr_t)r[19];uint64_t frame=dm_guest_frame();int changed=0;
+    pthread_mutex_lock(&rl_state_mu);
+    for(int i=0;i<8;i++)if(i!=slot && rl_hud_node[i]==node){rl_hud_node[i]=0;rl_hud_seen[i]=0;rl_hud_status[i]=2;}
+    if(!rl_hud_node[slot] || (rl_hud_node[slot]!=node && frame>rl_hud_touch[slot]+120)) {
+        rl_hud_node[slot]=node;rl_hud_seen[slot]=0;rl_hud_status[slot]=2;changed=1;
+    }
+    if(rl_hud_node[slot]==node)rl_hud_touch[slot]=frame;
+    pthread_mutex_unlock(&rl_state_mu);
+    if(changed)LOG("RL_HUD_BIND slot=%d node=%p player=%p",slot,(void *)node,(void *)(uintptr_t)r[20]);
+}
+static void hud_state(const uint64_t *r) {
+    if(atomic_load(&rl_phase)!=1)return;
+    const uint8_t *node=(const uint8_t *)(uintptr_t)r[19];int state;
+    memcpy(&state,node+0x140,4);
+    // Manual/replay overrides do not describe a live player reference.
+    if(node[0x16c] || state<0 || state>2)return;
+    uint64_t frame=dm_guest_frame();int changed=0,found=-1,special=node[0x166]!=0;
+    pthread_mutex_lock(&rl_state_mu);
+    for(int i=0;i<8;i++)if(rl_hud_node[i]==(uintptr_t)node) {
+        found=i;changed=!rl_hud_ever[i] || rl_hud_status[i]!=state || rl_hud_special[i]!=special;
+        if(rl_hud_seen[i] && frame>=rl_hud_frame[i] && frame-rl_hud_frame[i]<=120 && rl_hud_status[i]==0 && state==1)rl_hud_downs[i]++;
+        rl_hud_seen[i]=state<2;rl_hud_status[i]=state;rl_hud_ever[i]|=state<2;rl_hud_special[i]=node[0x166]!=0;
+        // The epilogue has finished setting Normal/Down/Absent and Special.
