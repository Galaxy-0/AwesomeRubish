+void hle_bind_system_event(void *ev,int mode) { if(bound_event)event_error=1;bound_event=ev;(void)mode; }
+void hle_signal_system_event(void *ev) { (void)ev;atomic_fetch_add(&events,1); }
+static uint8_t net[LDN_NET], config[32], security[68], user[48], filter[96];
+static void address(uint8_t *a,int player) { memset(a,0,16);a[0]=16;a[1]=2;a[2]=0x30;a[3]=0x39;a[4]=10;a[5]=13;a[7]=player+1; }
+int main(void) {
+    g_nmod=1;strcpy(g_mod[0].name,"main");strcpy(g_mod[0].build_id,"28c4287aee36f7499da60f3e68b54c70");
+    uint64_t cid=0x0100c2500fc20000ull;memcpy(config,&cid,8);config[10]=7;config[18]=8;config[20]=3;
+    security[0]=1;security[2]=16;memcpy(security+4,"local-passphrase",16);
+    snprintf((char *)user,32,"RL-%s",getenv("DM_PLAYER"));
+    setvbuf(stdout,NULL,_IOLBF,0);
+    uint8_t ev[256];h_ldn_Attach(ev);
+    printf("ready %u\n",h_ldn_Init());
+    char line[256];int fd=-1;
+    while(fgets(line,sizeof line,stdin)) {
+        Result r=RES_FAIL;int count=0;char cmd[64]={0},value[160]={0};sscanf(line,"%63s %159s",cmd,value);
+        if(!strcmp(cmd,"AP"))r=h_ldn_OpenAp();
+        else if(!strcmp(cmd,"STA"))r=h_ldn_OpenSta();
+        else if(!strcmp(cmd,"CLOSE_AP"))r=h_ldn_CloseAp();
+        else if(!strcmp(cmd,"CLOSE_STA"))r=h_ldn_CloseSta();
+        else if(!strcmp(cmd,"CREATE"))r=h_ldn_Create(config,security,user);
+        else if(!strcmp(cmd,"RESET")) {h_ldn_Fini();r=h_ldn_Init();h_ldn_Attach(ev);if(event_error)r=RES_FAIL;}
+        else if(!strcmp(cmd,"ADV"))r=h_ldn_Adv(value,strlen(value));
+        else if(!strcmp(cmd,"POLICY"))r=h_ldn_Policy(atoi(value));
+        else if(!strcmp(cmd,"SCAN")) {
+            memset(filter,0,96);memcpy(filter,config,16);uint32_t flags=0x25;filter[32]=2;
+            if(!strcmp(value,"type"))filter[32]=1;
+            if(!strcmp(value,"alltypes"))filter[32]=3;
+            memcpy(filter+92,&flags,4);
+            if(!strcmp(value,"wrong"))filter[10]++;
+            if(!strcmp(value,"channel"))count=11;
+            int channel=count;count=0;r=h_ldn_Scan(net,&count,1,filter,channel);
+        } else if(!strcmp(cmd,"JOIN")) {
+            uint8_t sec[68];memcpy(sec,security,68);if(!strcmp(value,"wrong"))sec[4]++;
+            r=h_ldn_Connect(net,sec,user,3,0);
+        } else if(!strcmp(cmd,"IP")) {uint32_t ip=0,mask=0;r=h_ldn_Ip(&ip,&mask);if(!r && (ip!=0x0a0d0001u+(unsigned)atoi(getenv("DM_PLAYER")) || mask!=0xffffff00u))r=RES_FAIL;}
