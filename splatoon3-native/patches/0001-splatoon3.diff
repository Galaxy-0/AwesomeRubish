+// Synthetic executable memory exercises opt-in/build/signature guards, no game image.
+#include "../hle_spl3_unlock.c"
+module_t g_mod[MAX_MOD]; int g_nmod;
+static int checks, failures;
+#define CHECK(label, condition) do { checks++; if (!(condition)) { failures++; fprintf(stderr, "FAIL %s\n", label); } } while (0)
+int main(int argc, char **argv) {
+    g_nmod = 1; module_t *m = &g_mod[0]; strcpy(m->name, "main");
+    strcpy(m->build_id, argc > 1 && !strcmp(argv[1], "unknown") ? "unknown" : "28c4287aee36f7499da60f3e68b54c70");
+    m->text_end = m->size = 0x4404000;
+    m->base = mmap(NULL, m->size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (m->base == MAP_FAILED) return 2;
+    for (unsigned i = 0; i < sizeof ownership_cuts / sizeof *ownership_cuts; i++)
+        *(uint32_t *)(m->base + ownership_cuts[i].offset) = ownership_cuts[i].expected;
+    if (argc > 1 && !strcmp(argv[1], "mismatch")) *(uint32_t *)(m->base + ownership_cuts[2].offset) = 0;
+    // Original predicate prefix: ldr ID; tbnz invalid -> false return.
+    *(uint32_t *)(m->base + 0x338bbe0) = 0xb9400428;
+    *(uint32_t *)(m->base + 0x338bbe4) = 0x37f81b48;
+    *(uint32_t *)(m->base + 0x338bf4c) = 0x2a1f03e0;
+    *(uint32_t *)(m->base + 0x338bf50) = 0xd65f03c0;
+    // Type guard exits become tiny stand-ins for native accept/skip loop arms.
+    *(uint32_t *)(m->base + 0x4401d74) = 0x52800000; // mov w0,0
+    *(uint32_t *)(m->base + 0x4401d78) = 0xd65f03c0;
+    *(uint32_t *)(m->base + 0x4401e4c) = 0x52800020; // mov w0,1
+    *(uint32_t *)(m->base + 0x4401e50) = 0xd65f03c0;
